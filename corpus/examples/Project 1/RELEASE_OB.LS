/PROG  RELEASE_OB
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Release OB";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-06  TIME 14:30:00;
MODIFIED	= DATE 26-07-06  TIME 14:30:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  ! === RELEASE_OB === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Reverse of CLOSE_OB. Opens active stations at ;
   4:  ! RUN DONE so OB can be unloaded. ;
   5:  ! Order: vac OFF + air push -> unclamp -> rotate ;
   6:  ! back to rest. Active stations only (R[154]/ ;
   7:  ! R[155]=1), read LIVE. No motion (DO/DI only). ;
   8:  ! No start precheck (teardown helper). ;
   9:  ! ;
  10:  ! States (R[56:RelStep]): ;
  11:  !  0 = guard, vac OFF + air push ON, timer ;
  12:  !  1 = air push done: push OFF, clamp OFF, timer ;
  13:  !  2 = verify clamp open, rotate OFF, timer ;
  14:  !  3 = verify inductive ON (rest), done ;
  15:  ! ;
  16:  ! Registers: ;
  17:  ! R[10:Error Code]   shared fault code (out) ;
  18:  ! R[14:PistTimeout]  clamp settle timeout sec (in) ;
  19:  ! R[24:RotateTO]     rotate settle timeout sec (in) ;
  20:  ! R[55:RelStatus]    2=busy 1=ok 0=fault (out) ;
  21:  ! R[56:RelStep]      internal state 0-3 ;
  22:  ! R[57:RelAirTime]   air-push pulse sec (in) ;
  23:  ! R[122:PistElapsed] timer readback scratch ;
  24:  ! R[154:St1Status]   1=St1 active (in) ;
  25:  ! R[155:St2Status]   1=St2 active (in) ;
  26:  ! ;
  27:  ! DO[406]  St1 vacuum   DO[470]  St2 vacuum ;
  28:  ! DO[407]  St1 airpush  DO[471]  St2 airpush ;
  29:  ! DO[1373] St1 clamp    DO[1377] St2 clamp ;
  30:  ! DO[1375] St1 rotate   DO[1379] St2 rotate ;
  31:  ! DI[402]  St1 induct   DI[434]  St2 induct ;
  32:  ! DI[400]  St1 clampUp  DI[401]  St1 clampDn ;
  33:  ! DI[432]  St2 clampUp  DI[433]  St2 clampDn ;
  34:  ! TIMER[2] shared RUN-phase timer. ;
  35:  ! ;
  36:  ! Error codes: ;
  37:  ! 930 = no OB station active on entry ;
  38:  ! 931 = St1 unclamp FAIL (Up/Down wrong) ;
  39:  ! 932 = St2 unclamp FAIL ;
  40:  ! 933 = St1 rotate-back FAIL (inductive not ON) ;
  41:  ! 934 = St2 rotate-back FAIL ;
  42:   ;
  43:  R[55:RelStatus]=2 ;
  44:   ;
  45:  ! --- Dispatch on state --- ;
  46:  SELECT R[56:RelStep]=0,JMP LBL[10] ;
  47:         =1,JMP LBL[20] ;
  48:         =2,JMP LBL[30] ;
  49:         =3,JMP LBL[40] ;
  50:         ELSE,JMP LBL[10] ;
  51:   ;
  52:   ;
  53:  ! ============================= ;
  54:  ! State 0: guard, vacuum OFF + air push ON, ;
  55:  !          start air-push pulse timer ;
  56:  ! ============================= ;
  57:  LBL[10] ;
  58:  ! Guard: at least one station must be active ;
  59:  IF R[154:St1Status]=1,JMP LBL[11] ;
  60:  IF R[155:St2Status]=1,JMP LBL[11] ;
  61:  R[10:Error Code]=930 ;
  62:  CALL SET_STR('No OB station',10) ;
  63:  JMP LBL[88] ;
  64:  LBL[11] ;
  65:   ;
  66:  ! St1: vacuum OFF, air push ON (active only) ;
  67:  IF R[154:St1Status]<>1,JMP LBL[12] ;
  68:  DO[406:X2.6 St1 Vacuum ACT]=OFF ;
  69:  DO[407:X2.7 St1 AirPush ACT]=ON ;
  70:  LBL[12] ;
  71:  ! St2: vacuum OFF, air push ON (active only) ;
  72:  IF R[155:St2Status]<>1,JMP LBL[13] ;
  73:  DO[470:X4.6 St2 Vacuum ACT]=OFF ;
  74:  DO[471:X4.7 St2 AirPush ACT]=ON ;
  75:  LBL[13] ;
  76:   ;
  77:  TIMER[2]=RESET ;
  78:  TIMER[2]=START ;
  79:  R[56:RelStep]=1 ;
  80:  JMP LBL[99] ;
  81:   ;
  82:   ;
  83:  ! ============================= ;
  84:  ! State 1: air-push pulse done -> push OFF, ;
  85:  !          command clamp OFF (unclamp), timer ;
  86:  ! ============================= ;
  87:  LBL[20] ;
  88:  R[122:PistElapsed]=TIMER[2] ;
  89:  IF R[122:PistElapsed]<R[57:RelAirTime],JMP LBL[99] ;
  90:  TIMER[2]=STOP ;
  91:   ;
  92:  ! St1: air push OFF, clamp OFF (active only) ;
  93:  IF R[154:St1Status]<>1,JMP LBL[21] ;
  94:  DO[407:X2.7 St1 AirPush ACT]=OFF ;
  95:  DO[1373:M5 - St1 OB Clamp ACT]=OFF ;
  96:  LBL[21] ;
  97:  ! St2: air push OFF, clamp OFF (active only) ;
  98:  IF R[155:St2Status]<>1,JMP LBL[22] ;
  99:  DO[471:X4.7 St2 AirPush ACT]=OFF ;
 100:  DO[1377:M9 - St2 OBClampPisto]=OFF ;
 101:  LBL[22] ;
 102:   ;
 103:  TIMER[2]=RESET ;
 104:  TIMER[2]=START ;
 105:  R[56:RelStep]=2 ;
 106:  JMP LBL[99] ;
 107:   ;
 108:   ;
 109:  ! ============================= ;
 110:  ! State 2: wait clamp settle (R[14:PistTimeout]), ;
 111:  !          verify clamp OPEN (Up ON AND Down OFF), ;
 112:  !          then command rotate OFF (back to rest) ;
 113:  ! ============================= ;
 114:  LBL[30] ;
 115:  R[122:PistElapsed]=TIMER[2] ;
 116:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
 117:   ;
 118:  ! St1 clamp: Up ON AND Down OFF ;
 119:  IF R[154:St1Status]<>1,JMP LBL[32] ;
 120:  IF DI[400:X2.0 St1 Clamp Up]<>ON,JMP LBL[31] ;
 121:  IF DI[401:X2.1 St1 Clamp Down]<>OFF,JMP LBL[31] ;
 122:  JMP LBL[32] ;
 123:  LBL[31] ;
 124:  R[10:Error Code]=931 ;
 125:  CALL SET_STR('St1 unclamp FAIL',10) ;
 126:  JMP LBL[88] ;
 127:  LBL[32] ;
 128:   ;
 129:  ! St2 clamp: Up ON AND Down OFF ;
 130:  IF R[155:St2Status]<>1,JMP LBL[34] ;
 131:  IF DI[432:X3.0 St2 Clamp Up]<>ON,JMP LBL[33] ;
 132:  IF DI[433:X3.1 St2 Clamp Down]<>OFF,JMP LBL[33] ;
 133:  JMP LBL[34] ;
 134:  LBL[33] ;
 135:  R[10:Error Code]=932 ;
 136:  CALL SET_STR('St2 unclamp FAIL',10) ;
 137:  JMP LBL[88] ;
 138:  LBL[34] ;
 139:   ;
 140:  ! Command rotate OFF (active only) ;
 141:  IF R[154:St1Status]<>1,JMP LBL[35] ;
 142:  DO[1375:M7- St1 OBRotatingPisto]=OFF ;
 143:  LBL[35] ;
 144:  IF R[155:St2Status]<>1,JMP LBL[36] ;
 145:  DO[1379:M11-St2 OBRotatingPiston]=OFF ;
 146:  LBL[36] ;
 147:   ;
 148:  TIMER[2]=RESET ;
 149:  TIMER[2]=START ;
 150:  R[56:RelStep]=3 ;
 151:  JMP LBL[99] ;
 152:   ;
 153:   ;
 154:  ! ============================= ;
 155:  ! State 3: wait rotate settle (R[24:RotateTO]), ;
 156:  !          verify inductive ON (back at rest) ;
 157:  ! ============================= ;
 158:  LBL[40] ;
 159:  R[122:PistElapsed]=TIMER[2] ;
 160:  IF R[122:PistElapsed]<R[24:RotateTO],JMP LBL[99] ;
 161:   ;
 162:  ! St1 inductive back ON ;
 163:  IF R[154:St1Status]<>1,JMP LBL[42] ;
 164:  IF DI[402:X2.2 St1 Inductive]<>ON,JMP LBL[41] ;
 165:  JMP LBL[42] ;
 166:  LBL[41] ;
 167:  R[10:Error Code]=933 ;
 168:  CALL SET_STR('St1 rotate FAIL',10) ;
 169:  JMP LBL[88] ;
 170:  LBL[42] ;
 171:   ;
 172:  ! St2 inductive back ON ;
 173:  IF R[155:St2Status]<>1,JMP LBL[44] ;
 174:  IF DI[434:X3.2 St2 inductive]<>ON,JMP LBL[43] ;
 175:  JMP LBL[44] ;
 176:  LBL[43] ;
 177:  R[10:Error Code]=934 ;
 178:  CALL SET_STR('St2 rotate FAIL',10) ;
 179:  JMP LBL[88] ;
 180:  LBL[44] ;
 181:   ;
 182:  ! All active stations released ;
 183:  TIMER[2]=STOP ;
 184:  R[10:Error Code]=0 ;
 185:  CALL SET_STR('ReleaseOB OK',10) ;
 186:  R[55:RelStatus]=1 ;
 187:  R[56:RelStep]=0 ;
 188:  JMP LBL[99] ;
 189:   ;
 190:   ;
 191:  ! ============================= ;
 192:  ! Fault: set status 0, reset state ;
 193:  ! ============================= ;
 194:  LBL[88] ;
 195:  TIMER[2]=STOP ;
 196:  R[55:RelStatus]=0 ;
 197:  R[56:RelStep]=0 ;
 198:  JMP LBL[99] ;
 199:   ;
 200:  LBL[99] ;
/POS
/END
