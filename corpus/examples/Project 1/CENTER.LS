/PROG  CENTER
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Center PBS";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-07  TIME 12:00:00;
MODIFIED	= DATE 26-07-07  TIME 14:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  ! === CENTER === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Called by RUN after VISION pass. Robot ;
   4:  ! arrives holding a good PBS. ;
   5:  ! Drop PBS in centering station, push square ;
   6:  ! with two pistons (one at a time, repeated), ;
   7:  ! then re-pick the squared PBS. ;
   8:  ! Frame UT3 / UF1 (UF unchanged all program). ;
   9:  ! ;
  10:  ! Push cycle (x R[42:CenterReps]): ;
  11:  !  Down ON -> dwell -> Down OFF -> ;
  12:  !  Right ON -> dwell -> Right OFF -> dwell ;
  13:  !  -> check DI[403] at cycle end. ;
  14:  ! Both pistons OFF (open) before re-pick. ;
  15:  ! Final square (once, after reps): ;
  16:  !  Down ON -> dwell -> Right ON -> dwell -> ;
  17:  !  Right OFF -> dwell -> Down OFF. Down is ;
  18:  !  held ON through the Right pulse. ;
  19:  ! No entry grip check (PBS may sit above the ;
  20:  ! gripper vacuum sensor range). ;
  21:  ! ;
  22:  ! Motion: P[1] on-way CNT -> P[2]+off -> P[2] ;
  23:  ! drop -> release -> P[2]+off lift -> push -> ;
  24:  ! PR[10]+off -> descend/grip -> lift -> P[1]. ;
  25:  ! ;
  26:  ! States (R[39:CtrStep]): ;
  27:  !  0 = reset reps; P[1]on-way,P[2]off,P[2]drop ;
  28:  !  1 = release: vac OFF, blow ON, timer ;
  29:  !  2 = blow off, lift P[2]off (no drop chk) ;
  30:  !  3 = Down ON, dwell timer ;
  31:  !  4 = Down OFF, Right ON, dwell timer ;
  32:  !  5 = Right OFF, dwell timer ;
  33:  !  6 = cycle end: check DI[403], count/loop ;
  34:  !  7 = final square: Down ON, dwell ;
  35:  !  8 = Right ON (Down held), dwell ;
  36:  !  9 = Right OFF (Down held), dwell ;
  37:  ! 10 = Down OFF, confirm DI[403] -> re-pick ;
  38:  ! 11 = approach re-pick PR[10]off ;
  39:  ! 12 = descend PR[10], vacuum ON, timer ;
  40:  ! 13 = grip ok -> lift PR[10]off, exit P[1], OK ;
  41:  ! ;
  42:  ! Registers: ;
  43:  ! R[10:Error Code]     shared fault code (out) ;
  44:  ! R[29:GripVacTime]    vacuum settle timeout s ;
  45:  ! R[30:GripBlowTime]   air-blow pulse sec ;
  46:  ! R[38:CtrStatus]      2=busy 1=ok 0=fault(out) ;
  47:  ! R[39:CtrStep]        internal state 0-9 ;
  48:  ! R[41:CenterDwell]    piston on/off dwell sec ;
  49:  ! R[42:CenterReps]     push-cycle repeats ;
  50:  ! R[43:CtrRepCnt]      cycles done 0..R[42] ;
  51:  ! R[63:TravelSpd]      approach/lift speed mm/sec ;
  52:  ! R[64:PrecSpd]        descend/precision speed mm/sec ;
  53:  ! R[122:PistElapsed]   timer readback scratch ;
  54:  ! ;
  55:  ! Position registers: ;
  56:  ! PR[9:ZOffset]        Z clearance offset (preset) ;
  57:  ! PR[10:CenterPickLoc] squared re-pick pose (preset) ;
  58:  ! ;
  59:  ! Points (UF1/UT3, taught): ;
  60:  ! P[1] = on the way (transit, CNT) ;
  61:  ! P[2] = drop point (approach via Z offset) ;
  62:  ! ;
  63:  ! IO: ;
  64:  ! DI[403:X2.3 PBS in centering St] ;
  65:  ! DI[370:X1.2 GripperVacuumReache] grip OK ;
  66:  ! DO[374:X1.6Gripper.VaccuumACT] ;
  67:  ! DO[375:X1.7Gripper.AirBlowACT] ;
  68:  ! DO[1371:M3 - PBSCenterPistonDown] top piston ;
  69:  ! DO[1369:M1- PBSCenterPistonRight] right piston ;
  70:  ! TIMER[2] shared RUN-phase timer. ;
  71:  ! ;
  72:  ! Error codes: ;
  73:  ! (401 retired: drop may miss sensor - OK) ;
  74:  ! 402 = PBS lost during centering (DI[403] OFF) ;
  75:  ! 403 = re-pick grip FAIL (DI[370] timeout) ;
  76:   ;
  77:  R[38:CtrStatus]=2 ;
  78:   ;
  79:  ! Sub owns tool; UF stays 1 all program ;
  80:  UTOOL_NUM=3 ;
  81:  UFRAME_NUM=1 ;
  82:   ;
  83:  ! --- Dispatch on state --- ;
  84:  SELECT R[39:CtrStep]=0,JMP LBL[10] ;
  85:         =1,JMP LBL[20] ;
  86:         =2,JMP LBL[30] ;
  87:         =3,JMP LBL[40] ;
  88:         =4,JMP LBL[50] ;
  89:         =5,JMP LBL[60] ;
  90:         =6,JMP LBL[65] ;
  91:         =7,JMP LBL[70] ;
  92:         =8,JMP LBL[71] ;
  93:         =9,JMP LBL[72] ;
  94:         =10,JMP LBL[73] ;
  95:         =11,JMP LBL[74] ;
  96:         =12,JMP LBL[75] ;
  97:         =13,JMP LBL[76] ;
  98:         ELSE,JMP LBL[10] ;
  99:   ;
 100:   ;
 101:  ! ============================= ;
 102:  ! State 0: reset reps, enter station ;
 103:  !  P[1] on-way -> P[2]+off -> P[2] drop ;
 104:  ! ============================= ;
 105:  LBL[10] ;
 106:  R[43:CtrRepCnt]=0 ;
 107:L P[1:On the way] R[63:TravelSpd]mm/sec CNT100    ;
 108:L P[2:Drop point] R[63:TravelSpd]mm/sec CNT5 Offset,PR[9:ZOffset]    ;
 109:L P[2:Drop point] R[64:PrecSpd]mm/sec FINE    ;
 110:  R[39:CtrStep]=1 ;
 111:  JMP LBL[99] ;
 112:   ;
 113:   ;
 114:  ! ============================= ;
 115:  ! State 1: release PBS (vac OFF, blow ON) ;
 116:  ! ============================= ;
 117:  LBL[20] ;
 118:  DO[374:X1.6Gripper.VaccuumACT]=OFF ;
 119:  DO[375:X1.7Gripper.AirBlowACT]=ON ;
 120:  TIMER[2]=RESET ;
 121:  TIMER[2]=START ;
 122:  R[39:CtrStep]=2 ;
 123:  JMP LBL[99] ;
 124:   ;
 125:   ;
 126:  ! ============================= ;
 127:  ! State 2: blow done -> blow OFF, lift to ;
 128:  !  P[2]+off. (no post-release DI[403] check: ;
 129:  !  PBS may land outside sensor range - OK) ;
 130:  ! ============================= ;
 131:  LBL[30] ;
 132:  R[122:PistElapsed]=TIMER[2] ;
 133:  IF R[122:PistElapsed]<R[30:GripBlowTime],JMP LBL[99] ;
 134:  TIMER[2]=STOP ;
 135:  DO[375:X1.7Gripper.AirBlowACT]=OFF ;
 136:L P[2:Drop point] R[63:TravelSpd]mm/sec CNT5 Offset,PR[9:ZOffset]    ;
 137:  R[39:CtrStep]=3 ;
 138:  JMP LBL[99] ;
 139:   ;
 140:   ;
 141:  ! ============================= ;
 142:  ! State 3: Down piston ON, start dwell ;
 143:  ! ============================= ;
 144:  LBL[40] ;
 145:  DO[1371:M3 - PBSCenterPistonDown]=ON ;
 146:  TIMER[2]=RESET ;
 147:  TIMER[2]=START ;
 148:  R[39:CtrStep]=4 ;
 149:  JMP LBL[99] ;
 150:   ;
 151:   ;
 152:  ! ============================= ;
 153:  ! State 4: dwell done -> Down OFF, Right ON ;
 154:  ! ============================= ;
 155:  LBL[50] ;
 156:  R[122:PistElapsed]=TIMER[2] ;
 157:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 158:  DO[1371:M3 - PBSCenterPistonDown]=OFF ;
 159:  DO[1369:M1- PBSCenterPistonRight]=ON ;
 160:  TIMER[2]=RESET ;
 161:  TIMER[2]=START ;
 162:  R[39:CtrStep]=5 ;
 163:  JMP LBL[99] ;
 164:   ;
 165:   ;
 166:  ! ============================= ;
 167:  ! State 5: dwell done -> Right OFF, dwell ;
 168:  ! ============================= ;
 169:  LBL[60] ;
 170:  R[122:PistElapsed]=TIMER[2] ;
 171:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 172:  DO[1369:M1- PBSCenterPistonRight]=OFF ;
 173:  TIMER[2]=RESET ;
 174:  TIMER[2]=START ;
 175:  R[39:CtrStep]=6 ;
 176:  JMP LBL[99] ;
 177:   ;
 178:   ;
 179:  ! ============================= ;
 180:  ! State 6: final dwell done -> check DI[403], ;
 181:  !  count cycle; loop to 3 or go to 7 ;
 182:  ! ============================= ;
 183:  LBL[65] ;
 184:  R[122:PistElapsed]=TIMER[2] ;
 185:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 186:  TIMER[2]=STOP ;
 187:  IF DI[403:X2.3 PBS in centering St]=ON,JMP LBL[66] ;
 188:  R[10:Error Code]=402 ;
 189:  CALL SET_STR('Center lost PBS',10) ;
 190:  JMP LBL[88] ;
 191:  LBL[66] ;
 192:  R[43:CtrRepCnt]=(R[43:CtrRepCnt]+1) ;
 193:  IF R[43:CtrRepCnt]<R[42:CenterReps],JMP LBL[67] ;
 194:  R[39:CtrStep]=7 ;
 195:  JMP LBL[99] ;
 196:  LBL[67] ;
 197:  R[39:CtrStep]=3 ;
 198:  JMP LBL[99] ;
 199:   ;
 200:   ;
 201:  ! ============================= ;
 202:  ! State 7: final square - Down ON, dwell ;
 203:  ! ============================= ;
 204:  LBL[70] ;
 205:  DO[1371:M3 - PBSCenterPistonDown]=ON ;
 206:  TIMER[2]=RESET ;
 207:  TIMER[2]=START ;
 208:  R[39:CtrStep]=8 ;
 209:  JMP LBL[99] ;
 210:   ;
 211:   ;
 212:  ! ============================= ;
 213:  ! State 8: dwell done -> Right ON (Down held) ;
 214:  ! ============================= ;
 215:  LBL[71] ;
 216:  R[122:PistElapsed]=TIMER[2] ;
 217:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 218:  DO[1369:M1- PBSCenterPistonRight]=ON ;
 219:  TIMER[2]=RESET ;
 220:  TIMER[2]=START ;
 221:  R[39:CtrStep]=9 ;
 222:  JMP LBL[99] ;
 223:   ;
 224:   ;
 225:  ! ============================= ;
 226:  ! State 9: dwell done -> Right OFF (Down held) ;
 227:  ! ============================= ;
 228:  LBL[72] ;
 229:  R[122:PistElapsed]=TIMER[2] ;
 230:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 231:  DO[1369:M1- PBSCenterPistonRight]=OFF ;
 232:  TIMER[2]=RESET ;
 233:  TIMER[2]=START ;
 234:  R[39:CtrStep]=10 ;
 235:  JMP LBL[99] ;
 236:   ;
 237:   ;
 238:  ! ============================= ;
 239:  ! State 10: Down OFF, chk DI[403] -> re-pick ;
 240:  ! ============================= ;
 241:  LBL[73] ;
 242:  R[122:PistElapsed]=TIMER[2] ;
 243:  IF R[122:PistElapsed]<R[41:CenterDwell],JMP LBL[99] ;
 244:  DO[1371:M3 - PBSCenterPistonDown]=OFF ;
 245:  TIMER[2]=STOP ;
 246:  IF DI[403:X2.3 PBS in centering St]=ON,JMP LBL[78] ;
 247:  R[10:Error Code]=402 ;
 248:  CALL SET_STR('Center lost PBS',10) ;
 249:  JMP LBL[88] ;
 250:  LBL[78] ;
 251:  R[39:CtrStep]=11 ;
 252:  JMP LBL[99] ;
 253:   ;
 254:   ;
 255:  ! ============================= ;
 256:  ! State 11: approach re-pick above PR[10] ;
 257:  ! ============================= ;
 258:  LBL[74] ;
 259:L PR[10:CenterPickLoc] R[63:TravelSpd]mm/sec CNT5 Offset,PR[9:ZOffset]    ;
 260:  R[39:CtrStep]=12 ;
 261:  JMP LBL[99] ;
 262:   ;
 263:   ;
 264:  ! ============================= ;
 265:  ! State 12: descend PR[10], vacuum ON, timer ;
 266:  ! ============================= ;
 267:  LBL[75] ;
 268:L PR[10:CenterPickLoc] R[64:PrecSpd]mm/sec FINE    ;
 269:  DO[374:X1.6Gripper.VaccuumACT]=ON ;
 270:  TIMER[2]=RESET ;
 271:  TIMER[2]=START ;
 272:  R[39:CtrStep]=13 ;
 273:  JMP LBL[99] ;
 274:   ;
 275:   ;
 276:  ! ============================= ;
 277:  ! State 13: wait grip (DI[370]) -> lift PR[10], ;
 278:  !  exit to P[1], report OK ;
 279:  ! ============================= ;
 280:  LBL[76] ;
 281:  IF DI[370:X1.2 GripperVacuumReache]=ON,JMP LBL[77] ;
 282:  R[122:PistElapsed]=TIMER[2] ;
 283:  IF R[122:PistElapsed]<R[29:GripVacTime],JMP LBL[99] ;
 284:  R[10:Error Code]=403 ;
 285:  CALL SET_STR('Center repick FAIL',10) ;
 286:  JMP LBL[88] ;
 287:  LBL[77] ;
 288:  TIMER[2]=STOP ;
 289:L PR[10:CenterPickLoc] R[63:TravelSpd]mm/sec CNT5 Offset,PR[9:ZOffset]    ;
 290:L P[1:On the way] R[63:TravelSpd]mm/sec CNT100    ;
 291:  R[10:Error Code]=0 ;
 292:  CALL SET_STR('Center OK',10) ;
 293:  R[38:CtrStatus]=1 ;
 294:  R[39:CtrStep]=0 ;
 295:  JMP LBL[99] ;
 296:   ;
 297:   ;
 298:  ! ============================= ;
 299:  ! Fault: pistons + blow OFF, status 0, reset ;
 300:  !  step. Vacuum left as-is. ;
 301:  ! ============================= ;
 302:  LBL[88] ;
 303:  DO[1371:M3 - PBSCenterPistonDown]=OFF ;
 304:  DO[1369:M1- PBSCenterPistonRight]=OFF ;
 305:  DO[375:X1.7Gripper.AirBlowACT]=OFF ;
 306:  TIMER[2]=STOP ;
 307:  R[38:CtrStatus]=0 ;
 308:  R[39:CtrStep]=0 ;
 309:  JMP LBL[99] ;
 310:   ;
 311:  LBL[99] ;
/POS
P[1]{
   GP1:
	UF : 1, UT : 3,		CONFIG : 'F U T, 0, 0, 0',
	X =   315.413989  mm,	Y =   441.551932  mm,	Z =  -46.778025  mm,
	W =     -.002920 deg,	P =    -1.495423 deg,	R =      .000134 deg
};
P[2]{
   GP1:
	UF : 1, UT : 3,		CONFIG : 'F U T, 0, 0, 0',
	X =   310.254989  mm,	Y =   449.620932  mm,	Z =  -300.023025  mm,
	W =     -.002920 deg,	P =    -1.495423 deg,	R =      .000134 deg
};

/END
