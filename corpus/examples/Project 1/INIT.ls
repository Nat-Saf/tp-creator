/PROG  INIT
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Init / reset";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-16  TIME 12:00:00;
MODIFIED	= DATE 26-07-05  TIME 16:35:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  ! === INIT PROGRAM === ;
   2:  ! Step-per-scan: ONE pass per call, no loop. ;
   3:  ! Outputs commanded every pass BEFORE checks, ;
   4:  ! so an early check fail cannot skip a reset. ;
   5:  ! R[90]: 2=busy 1=ok 0=fault(timeout). ;
   6:  R[90:InitStatus]=2 ;
   7:   ;
   8:  ! Settle timeout in seconds (change here) ;
   9:  !R[11:InitTimeout]=3 ;
  10:   ;
  11:   ;
  12:   ;
  13:  ! Start timer once on first entry ;
  14:  IF R[12:InitTmrRun]=1,JMP LBL[5] ;
  15:  TIMER[1]=RESET ;
  16:  TIMER[1]=START ;
  17:  R[12:InitTmrRun]=1 ;
  18:  LBL[5] ;
  19:   ;
  20:  ! --- Command all resets (no jumps here) --- ;
  21:  ! Manifold, clamps, rotating pistons ;
  22:  DO[1369:M1- PBSCenterPistonRight]=OFF ;
  23:  DO[1371:M3 - PBSCenterPistonDown]=OFF ;
  24:  DO[1373:M5 - St1 OB Clamp ACT]=OFF ;
  25:  DO[1375:M7- St1 OBRotatingPisto]=OFF ;
  26:  DO[1377:M9 - St2 OBClampPisto]=OFF ;
  27:  DO[1379:M11-St2 OBRotatingPiston]=OFF ;
  28:  ! OB vacuums + air push ;
  29:  DO[406:X2.6 St1 Vacuum ACT]=OFF ;
  30:  DO[470:X4.6 St2 Vacuum ACT]=OFF ;
  31:  DO[407:X2.7 St1 AirPush ACT]=OFF ;
  32:  DO[471:X4.7 St2 AirPush ACT]=OFF ;
  33:  ! Gripper ;
  34:  DO[372:X1.4Gripper.DisPistonACT]=OFF ;
  35:  DO[375:X1.7Gripper.AirBlowACT]=OFF ;
  36:  DO[374:X1.6Gripper.VaccuumACT]=OFF ;
  37:  ! DO[373:X1.5Gripper.UVPistonACT]=OFF ;
  38:  ! Dispenser and UV (dispense is reverse) ;
  39:  DO[437:X3.5 DispenseSTOP]=ON ;
  40:  DO[464:X4.0 UV Channel 1]=OFF ;
  41:  DO[465:X4.1 UV Channel 2]=OFF ;
  42:   ;
  43:  ! --- Checks (short-circuit on first fail) --- ;
  44:  ! Main air supply ;
  45:  R[10:Error Code]=101 ;
  46:  CALL SET_STR('Air supply FAIL',10) ;
  47:  IF DI[439:X3.7 Main Air Sensor]<>ON,JMP LBL[80] ;
  48:   ;
  49:  ! St1 clamp (M5) ;
  50:  R[10:Error Code]=102 ;
  51:  CALL SET_STR('St1 ClampUp FAIL',10) ;
  52:  IF DI[400:X2.0 St1 Clamp Up]<>ON,JMP LBL[80] ;
  53:  R[10:Error Code]=103 ;
  54:  CALL SET_STR('St1 ClampDn FAIL',10) ;
  55:  IF DI[401:X2.1 St1 Clamp Down]<>OFF,JMP LBL[80] ;
  56:   ;
  57:  ! St1 rotate (M7) ;
  58:  R[10:Error Code]=104 ;
  59:  CALL SET_STR('St1 Induct FAIL',10) ;
  60:  IF DI[402:X2.2 St1 Inductive]<>ON,JMP LBL[80] ;
  61:   ;
  62:  ! St2 clamp (M9) ;
  63:  R[10:Error Code]=105 ;
  64:  CALL SET_STR('St2 ClampUp FAIL',10) ;
  65:  IF DI[432:X3.0 St2 Clamp Up]<>ON,JMP LBL[80] ;
  66:  R[10:Error Code]=106 ;
  67:  CALL SET_STR('St2 ClampDn FAIL',10) ;
  68:  IF DI[433:X3.1 St2 Clamp Down]<>OFF,JMP LBL[80] ;
  69:   ;
  70:  ! St2 rotate (M11) ;
  71:  R[10:Error Code]=107 ;
  72:  CALL SET_STR('St2 Induct FAIL',10) ;
  73:  IF DI[434:X3.2 St2 inductive]<>ON,JMP LBL[80] ;
  74:   ;
  75:  ! OB vacuums (reached sensors must be OFF) ;
  76:  R[10:Error Code]=108 ;
  77:  CALL SET_STR('St1 Vacuum FAIL',10) ;
  78:  IF DI[404:X2.4 St1 Vacuum Reached]<>OFF,JMP LBL[80] ;
  79:  R[10:Error Code]=109 ;
  80:  CALL SET_STR('St2 Vacuum FAIL',10) ;
  81:  IF DI[469:X4.5 St2 Vacuum Reached]<>OFF,JMP LBL[80] ;
  82:   ;
  83:  ! Gripper ;
  84:  R[10:Error Code]=110 ;
  85:  CALL SET_STR('Disp Up FAIL',10) ;
  86:  IF DI[368:X1.0 DispPistonUp]<>ON,JMP LBL[80] ;
  87:  R[10:Error Code]=111 ;
  88:  CALL SET_STR('Disp Dn FAIL',10) ;
  89:  IF DI[369:X1.1 DispPistonDown]<>OFF,JMP LBL[80] ;
  90:  R[10:Error Code]=112 ;
  91:  CALL SET_STR('Grip Vac FAIL',10) ;
  92:  IF DI[370:X1.2 GripperVacuumReache]<>OFF,JMP LBL[80] ;
  93:   ;
  94:  ! PBS centering station empty ;
  95:  R[10:Error Code]=113 ;
  96:  CALL SET_STR('PBS center FAIL',10) ;
  97:  IF DI[403:X2.3 PBS in centering St]<>OFF,JMP LBL[80] ;
  98:   ;
  99:  ! All inputs good: lift then go home ;
 100:  TIMER[1]=STOP ;
 101:  R[12:InitTmrRun]=0 ;
 102:  ! Lift +Z in active frame (UTOOL unchanged) ;
 103:  PR[5:InitLiftPos]=LPOS ;
 104:  PR[5,3]=(PR[5,3]+R[150:InitZLift]) ;
 105:L PR[5:InitLiftPos] 100mm/sec FINE    ;
 106:  ! Move to home in world frame ;
 107:  UFRAME_NUM=0 ;
 108:L PR[1:Home] 100mm/sec FINE    ;
 109:  R[10:Error Code]=0 ;
 110:  CALL SET_STR('INIT OK',10) ;
 111:  R[90:InitStatus]=1 ;
 112:  JMP LBL[99] ;
 113:   ;
 114:  ! A check failed - stay busy until timeout ;
 115:  LBL[80] ;
 116:  R[13:InitElapsed]=TIMER[1] ;
 117:  IF R[13:InitElapsed]<R[11:InitTimeout],JMP LBL[99] ;
 118:   ;
 119:  ! Timeout reached, fault still present ;
 120:  TIMER[1]=STOP ;
 121:  R[12:InitTmrRun]=0 ;
 122:  R[90:InitStatus]=0 ;
 123:  LBL[99] ;
/POS
/END
