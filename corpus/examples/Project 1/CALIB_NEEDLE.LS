/PROG  CALIB_NEEDLE
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Calib needle";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-21  TIME 10:57:48;
MODIFIED	= DATE 26-06-30  TIME 12:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/MN
   1:  ! === CALIB_NEEDLE === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Called by MAIN; calls CALIB_MEASURE. ;
   4:  ! ;
   5:  ! States: ;
   6:  !  0 = init, mode/prechecks, move to P[1] ;
   7:  !  1 = lower needle, start settle timer ;
   8:  !  2 = wait for needle DOWN sensor ;
   9:  !  3 = Z-find: step Z down until tip hits Y-beam ;
  10:  !  4 = run CALIB_MEASURE (4-sweep XY solve) ;
  11:  !  5 = move tip to solved intersection ;
  12:  !  6 = verify both beams blocked + hold 3 s ;
  13:  !  7 = apply UTOOL update, then raise needle ;
  14:  !  8 = wait needle UP, go home ;
  15:  ! ;
  16:  ! Registers: ;
  17:  ! R[10:ErrCode]      shared fault code (out) ;
  18:  ! R[14:PistTimeout]  piston move timeout seconds ;
  19:  ! R[100:CalibStatus] 2=busy 1=ok 0=fault (out) ;
  20:  ! R[101:MeasStatus]  CALIB_MEASURE status (in) ;
  21:  ! R[110:Mode]        0=set ref 1=calib 2=revert ;
  22:  ! R[111:ProbeSpd]    Z-find sweep speed mm/sec ;
  23:  ! R[112:TipStep]     Z step size per Z-find pass ;
  24:  ! R[113:MaxTravel]   max Z descent before fault ;
  25:  ! R[116:TipZ]        Z where tip broke beam (out) ;
  26:  ! R[117:CalibStep]   internal state 0-8 ;
  27:  ! R[118:Descent]     accumulated Z descent so far ;
  28:  ! R[119:SearchZ]     current Z for Z-find sweep ;
  29:  ! R[122:PistElapsed] timer readback scratch ;
  30:  ! R[123:TipX]        solved tip X (from CALIB_MEASURE) ;
  31:  ! R[124:TipY]        solved tip Y (from CALIB_MEASURE) ;
  32:  ! R[126:RefSet]      0=no ref stored  1=ref stored ;
  33:  ! R[128:ProbeZDrop]  Z below TipZ for sweeps ;
  34:  ! ;
  35:  ! Position registers: ;
  36:  ! PR[1:Home]         robot home (world frame) ;
  37:  ! PR[3:CalibDelta]   XYZ offset (from CALIB_MEASURE) ;
  38:  ! PR[4:RefTipPos]    reference tip XYZ (mode 0) ;
  39:  ! PR[6:TipPos]       last calibrated tip XYZ (out) ;
  40:  ! PR[7:FrameTmp]     temp UTOOL scratch ;
  41:  ! PR[11:ZfindSweepL] Z-find sweep left end (copy of P[2]) ;
  42:  ! PR[12:ZfindSweepR] Z-find sweep right end (copy of P[3]) ;
  43:  ! PR[13:CalibHome]   calib home (copy of P[1]) ;
  44:  ! PR[14:SweepStart]  Z-adjusted sweep start ;
  45:  ! PR[15:SweepEnd]    Z-adjusted sweep end ;
  46:  ! PR[29:ScratchPos]  temp position scratch ;
  47:  ! ;
  48:  ! Points: ;
  49:  ! P[1]  calib home - safe position above beam zone ;
  50:  ! P[2]  Z-find sweep start - W end of Y-beam (DI[436]) ;
  51:  ! P[3]  Z-find sweep end   - E end of Y-beam (DI[436]) ;
  52:  ! P[10] retract position after Z-find success ;
  53:  ! ;
  54:  ! DI[368] dispense piston UP sensor ;
  55:  ! DI[369] dispense piston DOWN sensor ;
  56:  ! DI[435] X Tip Calibration beam ;
  57:  ! DI[436] Y Tip Calibration beam (used for Z-find) ;
  58:  ! DO[372] dispense piston actuate (ON=down, OFF=up) ;
  59:  ! ;
  60:  ! UTOOL updated in State 7, after verification: ;
  61:  !  Mode 0: UTOOL[1]->UTOOL[2] snapshot, R[126]=1 ;
  62:  !  Mode 1: UTOOL[2]+PR[3:CalibDelta]->UTOOL[1] ;
  63:  ! Measurement motion rides UT2 in Mode 1 (fixed ;
  64:  ! reference) / UT1 in Mode 0, so the M1-M0 delta ;
  65:  ! basis stays constant and repeated M1 cannot drift. ;
  66:  ! ;
  67:  ! PR[6:TipPos] = LPOS captured in State 7 AFTER ;
  68:  ! the UTOOL[1] update, robot still on the crossing ;
  69:  ! (needle down). Point + tool are a matched pair, ;
  70:  ! so TIP_VERIFY replays it as L PR[6:TipPos] with ;
  71:  ! UTOOL_NUM=1 - no PR[4]/PR[3] math, cannot drift. ;
  72:   ;
  73:  R[100:CalibStatus]=2 ;
  74:   ;
  75:  ! Enforce needle-down check in states 3-6 only ;
  76:  IF R[117:CalibStep]<3,JMP LBL[1] ;
  77:  IF R[117:CalibStep]>6,JMP LBL[1] ;
  78:  IF DI[369:X1.1 DispPistonDown]=ON,JMP LBL[1] ;
  79:  R[10:ErrCode]=811 ;
  80:  CALL SET_STR('Needle not down',10) ;
  81:  JMP LBL[88] ;
  82:  LBL[1] ;
  83:   ;
  84:  ! --- Dispatch on state --- ;
  85:  SELECT R[117:CalibStep]=0,JMP LBL[10] ;
  86:         =1,JMP LBL[20] ;
  87:         =2,JMP LBL[30] ;
  88:         =3,JMP LBL[40] ;
  89:         =4,JMP LBL[50] ;
  90:         =5,JMP LBL[60] ;
  91:         =6,JMP LBL[65] ;
  92:         =7,JMP LBL[68] ;
  93:         =8,JMP LBL[75] ;
  94:         ELSE,JMP LBL[10] ;
  95:   ;
  96:   ;
  97:  ! ============================= ;
  98:  ! State 0: init, mode checks, prechecks, ;
  99:  !          move to P[1], init Z-find vars ;
 100:  ! ============================= ;
 101:  LBL[10] ;
 102:  ! Measure tool: Mode 1 rides UT2 (fixed ref); ;
 103:  ! Mode 0 rides UT1 (UT2 is set this run, St7). ;
 104:  UTOOL_NUM=1 ;
 105:  IF R[110:Mode]<>1,JMP LBL[2] ;
 106:  UTOOL_NUM=2 ;
 107:  LBL[2] ;
 108:  UFRAME_NUM=1 ;
 109:   ;
 110:  ! Mode 2 = revert: no motion, skip straight to LBL[90] ;
 111:  IF R[110:Mode]=2,JMP LBL[90] ;
 112:   ;
 113:  ! Mode 0: block if reference already stored ;
 114:  ! Set R[126:RefSet]=0 first to overwrite (see operator doc) ;
 115:  IF R[110:Mode]<>0,JMP LBL[12] ;
 116:  IF R[126:RefSet]<>1,JMP LBL[12] ;
 117:  R[10:ErrCode]=808 ;
 118:  CALL SET_STR('Ref already set',10) ;
 119:  JMP LBL[88] ;
 120:  LBL[12] ;
 121:   ;
 122:  ! Mode 1: reference must exist before calibrating ;
 123:  IF R[110:Mode]<>1,JMP LBL[13] ;
 124:  IF R[126:RefSet]=1,JMP LBL[13] ;
 125:  R[10:ErrCode]=807 ;
 126:  CALL SET_STR('No reference set',10) ;
 127:  JMP LBL[88] ;
 128:  LBL[13] ;
 129:   ;
 130:  ! Precheck: dispense piston must be UP ;
 131:  ! DI[368]=ON (up sensor) AND DI[369]=OFF (not at down) ;
 132:  IF DI[368:X1.0 DispPistonUp]<>ON,JMP LBL[14] ;
 133:  IF DI[369:X1.1 DispPistonDown]<>OFF,JMP LBL[14] ;
 134:  JMP LBL[15] ;
 135:  LBL[14] ;
 136:  R[10:ErrCode]=803 ;
 137:  CALL SET_STR('Disp piston not up',10) ;
 138:  JMP LBL[88] ;
 139:  LBL[15] ;
 140:   ;
 141:  ! Precheck: both calibration beams must be clear ;
 142:  IF DI[435:X3.3-X Tip Calibration]=ON,JMP LBL[16] ;
 143:  IF DI[436:X3.4-Y Tip Calibration]=ON,JMP LBL[16] ;
 144:  JMP LBL[17] ;
 145:  LBL[16] ;
 146:  R[10:ErrCode]=801 ;
 147:  CALL SET_STR('Beams not clear',10) ;
 148:  JMP LBL[88] ;
 149:  LBL[17] ;
 150:   ;
 151:  ! All checks passed: move to calib home ;
 152:L P[1] 200mm/sec FINE    ;
 153:  ! Capture sweep reference positions and home ;
 154:  PR[13:CalibHome]=P[1] ;
 155:  PR[11:ZfindSweepL]=P[2] ;
 156:  PR[12:ZfindSweepR]=P[3] ;
 157:  ! Init Z-find: start at P[1].Z and step downward ;
 158:  R[119:SearchZ]=PR[13,3] ;
 159:  R[118:Descent]=0 ;
 160:  R[10:ErrCode]=0 ;
 161:  R[117:CalibStep]=1 ;
 162:  JMP LBL[99] ;
 163:   ;
 164:   ;
 165:  ! ============================= ;
 166:  ! State 1: command needle DOWN, start settle timer ;
 167:  ! DO[372] ON = dispense piston actuate (needle down) ;
 168:  ! ============================= ;
 169:  LBL[20] ;
 170:  DO[372:X1.4Gripper.DisPistonACT]=ON ;
 171:  TIMER[1]=RESET ;
 172:  TIMER[1]=START ;
 173:  R[117:CalibStep]=2 ;
 174:  JMP LBL[99] ;
 175:   ;
 176:   ;
 177:  ! ============================= ;
 178:  ! State 2: wait for needle DOWN sensor ;
 179:  ! DI[369] ON = piston at down position. ;
 180:  ! Timeout: R[14:PistTimeout] seconds -> fault 809. ;
 181:  ! ============================= ;
 182:  LBL[30] ;
 183:  IF DI[369:X1.1 DispPistonDown]=ON,JMP LBL[32] ;
 184:  R[122:PistElapsed]=TIMER[1] ;
 185:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
 186:  R[10:ErrCode]=809 ;
 187:  CALL SET_STR('Disp pist dn FAIL',10) ;
 188:  JMP LBL[88] ;
 189:  LBL[32] ;
 190:  TIMER[1]=STOP ;
 191:  R[117:CalibStep]=3 ;
 192:  JMP LBL[99] ;
 193:   ;
 194:   ;
 195:  ! ============================= ;
 196:  ! State 3: Z-find sweep using Y-beam DI[436] ;
 197:  ! Builds PR[14:SweepStart]/PR[15:SweepEnd] at ;
 198:  ! current R[119:SearchZ]. Sweeps X across Y-beam. ;
 199:  ! Tip hits beam -> skip taken -> R[116:TipZ] set. ;
 200:  ! No hit -> step R[119] down by R[112:TipStep]. ;
 201:  ! Abort if R[118:Descent] > R[113:MaxTravel]. ;
 202:  ! P[10] = retract after Z-find success. ;
 203:  ! ============================= ;
 204:  LBL[40] ;
 205:  SKIP CONDITION DI[436:X3.4-Y Tip Calibration]=ON ;
 206:  ! Build sweep targets at current search Z ;
 207:  PR[14:SweepStart]=PR[11:ZfindSweepL] ;
 208:  PR[14,3]=R[119:SearchZ] ;
 209:  PR[15:SweepEnd]=PR[12:ZfindSweepR] ;
 210:  PR[15,3]=R[119:SearchZ] ;
 211:L PR[14:SweepStart] 50mm/sec FINE    ;
 212:L PR[15:SweepEnd] R[111:ProbeSpd]mm/sec FINE Skip,LBL[42]    ;
 213:  ! Skip taken: tip broke Y-beam -> Z found ;
 214:  R[116:TipZ]=R[119:SearchZ] ;
 215:L P[10] 50mm/sec FINE    ;
 216:  R[117:CalibStep]=4 ;
 217:  JMP LBL[99] ;
 218:  LBL[42] ;
 219:  ! No beam trip: step Z down and retry ;
 220:  R[118:Descent]=(R[118:Descent]+R[112:TipStep]) ;
 221:  IF R[118:Descent]>R[113:MaxTravel],JMP LBL[82] ;
 222:  R[119:SearchZ]=(R[119:SearchZ]-R[112:TipStep]) ;
 223:  JMP LBL[99] ;
 224:   ;
 225:   ;
 226:  ! ============================= ;
 227:  ! State 4: run CALIB_MEASURE ;
 228:  ! Runs step-per-scan; stay in state 4 until done. ;
 229:  ! R[101:MeasStatus]: 2=busy 1=ok 0=fault. ;
 230:  ! On ok: R[123:TipX], R[124:TipY] and ;
 231:  !        PR[3:CalibDelta] / PR[4:RefTipPos] set. ;
 232:  ! UTOOL[1] is NOT modified by CALIB_MEASURE. ;
 233:  ! ============================= ;
 234:  LBL[50] ;
 235:  CALL CALIB_MEASURE ;
 236:  IF R[101:MeasStatus]=2,JMP LBL[99] ;
 237:  IF R[101:MeasStatus]=0,JMP LBL[88] ;
 238:  R[117:CalibStep]=5 ;
 239:  JMP LBL[99] ;
 240:   ;
 241:   ;
 242:  ! ============================= ;
 243:  ! State 5: move tip to solved intersection point ;
 244:  ! Target: (R[123:TipX], R[124:TipY], TipZ-ProbeZDrop) ;
 245:  ! Under measure tool (UT2 in M1, UT1 in M0). ;
 246:  ! Z = TipZ - ProbeZDrop = same height as all sweeps. ;
 247:  ! ============================= ;
 248:  LBL[60] ;
 249:  PR[29,1]=R[123:TipX] ;
 250:  PR[29,2]=R[124:TipY] ;
 251:  ! Z must match sweep height, not raw TipZ ;
 252:  PR[29,3]=R[116:TipZ]-R[128:ProbeZDrop] ;
 253:  PR[29,4]=0 ;
 254:  PR[29,5]=0 ;
 255:  PR[29,6]=0 ;
 256:L PR[29:ScratchPos] 50mm/sec FINE    ;
 257:  TIMER[1]=RESET ;
 258:  TIMER[1]=START ;
 259:  R[117:CalibStep]=6 ;
 260:  JMP LBL[99] ;
 261:   ;
 262:   ;
 263:  ! ============================= ;
 264:  ! State 6: verify both beams blocked + hold 3 s ;
 265:  ! DI[435] (X-beam) AND DI[436] (Y-beam) must be ON. ;
 266:  ! Either beam clear = bad XY solve -> fault 812. ;
 267:  ! Hold runs every scan; advance after 3 s. ;
 268:  ! ============================= ;
 269:  LBL[65] ;
 270:  IF DI[435:X3.3-X Tip Calibration]=OFF,JMP LBL[63] ;
 271:  IF DI[436:X3.4-Y Tip Calibration]=OFF,JMP LBL[63] ;
 272:  R[122:PistElapsed]=TIMER[1] ;
 273:  IF R[122:PistElapsed]<3,JMP LBL[99] ;
 274:  TIMER[1]=STOP ;
 275:  R[117:CalibStep]=7 ;
 276:  JMP LBL[99] ;
 277:  LBL[63] ;
 278:  R[10:ErrCode]=812 ;
 279:  CALL SET_STR('Tip verify FAIL',10) ;
 280:  JMP LBL[88] ;
 281:   ;
 282:   ;
 283:  ! ============================= ;
 284:  ! State 7: apply UTOOL update, then raise needle ;
 285:  ! Verification passed -> UTOOL safe to update now. ;
 286:  ! ;
 287:  ! Mode 0: snapshot UTOOL[1]->UTOOL[2] (baseline). ;
 288:  !         Set R[126:RefSet]=1. ;
 289:  ! Mode 1: UTOOL[2] + PR[3:CalibDelta] -> UTOOL[1]. ;
 290:  !         PR[3,1]=dX  PR[3,2]=dY  PR[3,3]=dZ. ;
 291:  ! ;
 292:  ! After update: store PR[6:TipPos], raise needle ;
 293:  ! (DO[372]=OFF). ;
 294:  ! ============================= ;
 295:  LBL[68] ;
 296:  ! Apply UTOOL update (mode-dependent) ;
 297:  IF R[110:Mode]=1,JMP LBL[69] ;
 298:  ! Mode 0: snapshot UTOOL[1] into UTOOL[2] as baseline ;
 299:  PR[7:FrameTmp]=UTOOL[1] ;
 300:  UTOOL[2]=PR[7:FrameTmp] ;
 301:  R[126:RefSet]=1 ;
 302:  JMP LBL[66] ;
 303:  LBL[69] ;
 304:  ! Mode 1: add CalibDelta to UTOOL[2] -> UTOOL[1] ;
 305:  PR[7:FrameTmp]=UTOOL[2] ;
 306:  PR[7,1]=(PR[7,1]+PR[3,1]) ;
 307:  PR[7,2]=(PR[7,2]+PR[3,2]) ;
 308:  PR[7,3]=(PR[7,3]+PR[3,3]) ;
 309:  UTOOL[1]=PR[7:FrameTmp] ;
 310:  LBL[66] ;
 311:  ! Measure ran under UT2 in Mode 1; switch to ;
 312:  ! UT1 so PR[6] is captured in the UT1 basis ;
 313:  ! (matched pair for TIP_VERIFY replay). ;
 314:  UTOOL_NUM=1 ;
 315:  ! Capture the crossing NOW, in the updated ;
 316:  ! UTOOL[1] basis. Robot is still on the crossing ;
 317:  ! (needle down, beams verified). LPOS with ;
 318:  ! UTOOL[1] active = calibrated tip point. Full ;
 319:  ! pose + valid config; matched pair for replay. ;
 320:  PR[6:TipPos]=LPOS ;
 321:  ! Raise needle ;
 322:  DO[372:X1.4Gripper.DisPistonACT]=OFF ;
 323:  TIMER[1]=RESET ;
 324:  TIMER[1]=START ;
 325:  R[117:CalibStep]=8 ;
 326:  JMP LBL[99] ;
 327:   ;
 328:   ;
 329:  ! ============================= ;
 330:  ! State 8: wait for needle UP, go home ;
 331:  ! DI[368] ON = piston at up position. ;
 332:  ! Timeout: R[14:PistTimeout] seconds -> fault 810. ;
 333:  ! PR[1:Home] = robot home in world frame (UFRAME=0). ;
 334:  ! ============================= ;
 335:  LBL[75] ;
 336:  IF DI[368:X1.0 DispPistonUp]=ON,JMP LBL[72] ;
 337:  R[122:PistElapsed]=TIMER[1] ;
 338:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
 339:  R[10:ErrCode]=810 ;
 340:  CALL SET_STR('Disp pist up FAIL',10) ;
 341:  JMP LBL[88] ;
 342:  LBL[72] ;
 343:  TIMER[1]=STOP ;
 344:L PR[1:Home] 200mm/sec FINE    ;
 345:  R[10:ErrCode]=0 ;
 346:  CALL SET_STR('Calib OK',10) ;
 347:  R[100:CalibStatus]=1 ;
 348:  R[117:CalibStep]=0 ;
 349:  JMP LBL[99] ;
 350:   ;
 351:   ;
 352:  ! ============================= ;
 353:  ! Tip not found within Z travel range (fault 802) ;
 354:  ! Check R[113:MaxTravel] and needle physical position. ;
 355:  ! ============================= ;
 356:  LBL[82] ;
 357:  R[10:ErrCode]=802 ;
 358:  CALL SET_STR('Tip not found',10) ;
 359:  JMP LBL[88] ;
 360:   ;
 361:   ;
 362:  ! ============================= ;
 363:  ! Revert (Mode 2): restore UTOOL[1] from UTOOL[2] ;
 364:  ! No motion. PR[3:CalibDelta] zeroed. ;
 365:  ! PR[6:TipPos] reset to PR[4:RefTipPos] (delta=0). ;
 366:  ! UTOOL[2] must contain a valid known-good baseline. ;
 367:  ! ============================= ;
 368:  LBL[90] ;
 369:  PR[7:FrameTmp]=UTOOL[2] ;
 370:  UTOOL[1]=PR[7:FrameTmp] ;
 371:  PR[3,1]=0 ;
 372:  PR[3,2]=0 ;
 373:  PR[3,3]=0 ;
 374:  PR[6,1]=PR[4,1] ;
 375:  PR[6,2]=PR[4,2] ;
 376:  PR[6,3]=PR[4,3] ;
 377:  PR[6,4]=0 ;
 378:  PR[6,5]=0 ;
 379:  PR[6,6]=0 ;
 380:  R[10:ErrCode]=0 ;
 381:  CALL SET_STR('Revert done',10) ;
 382:  R[100:CalibStatus]=1 ;
 383:  R[117:CalibStep]=0 ;
 384:  JMP LBL[99] ;
 385:   ;
 386:   ;
 387:  ! ============================= ;
 388:  ! Fault: set status 0, reset state ;
 389:  ! Needle left as-is (may need manual recovery). ;
 390:  ! Read R[10:ErrCode] and SR[10] for cause. ;
 391:  ! ============================= ;
 392:  LBL[88] ;
 393:  R[100:CalibStatus]=0 ;
 394:  R[117:CalibStep]=0 ;
 395:  JMP LBL[99] ;
 396:   ;
 397:  LBL[99] ;
/POS
P[1]{
   GP1:
	UF : 1, UT : 2,		CONFIG : 'F U T, 0, 0, 0',
	X =  -340.608917  mm,	Y =   340.989685  mm,	Z =  -211.000000  mm,
	W =     -.000991 deg,	P =     -.001491 deg,	R =     -.002565 deg
};
P[2]{
   GP1:
	UF : 1, UT : 2,		CONFIG : 'F U T, 0, 0, 0',
	X =  -333.960571  mm,	Y =   326.947845  mm,	Z =  -212.600000  mm,
	W =     -.000733 deg,	P =      .000230 deg,	R =     -.003536 deg
};
P[3]{
   GP1:
	UF : 1, UT : 2,		CONFIG : 'F U T, 0, 0, 0',
	X =  -343.274628  mm,	Y =   326.948517  mm,	Z =  -212.600000  mm,
	W =     -.000718 deg,	P =      .000202 deg,	R =     -.003559 deg
};
P[10]{
   GP1:
	UF : 1, UT : 2,		CONFIG : 'F U T, 0, 0, 0',
	X =  -340.608887  mm,	Y =   343.560791  mm,	Z =  -197.695267  mm,
	W =     -.000967 deg,	P =     -.001513 deg,	R =     -.002449 deg
};
/END
