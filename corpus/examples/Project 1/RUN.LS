/PROG  RUN
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "RUN orch";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-05  TIME 17:45:00;
MODIFIED	= DATE 26-07-09  TIME 12:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  ! === RUN === ;
   2:  ! Step-per-scan orchestrator. ONE pass per call. ;
   3:  ! Called by MAIN in RUN state; MAIN checks R[20]. ;
   4:  ! SHELL: CLOSE_OB + TIP_VERIFY + PICK + VISION ;
   5:  ! + RETURN(no-go) + CENTER + DISPENSE + PLACE ;
   6:  ! + RELEASE_OB. ;
   7:  ! ;
   8:  ! Flow: ;
   9:  !  0 setup -> 1 CLOSE_OB -> 2 TIP_VERIFY -> ;
  10:  !  3 PICK -> 4 VISION -> pass: 6 CENTER -> ;
  11:  !  7 DISPENSE -> 8 PLACE(+cure) -> ;
  12:  !  10 RELEASE_OB -> DONE ;
  13:  !          no-go: 5 RETURN_PBS -> back to 3 PICK ;
  14:  ! (state 9 reserved). ;
  15:  ! ;
  16:  ! Registers: ;
  17:  ! R[7:RUN_STEP]      internal state ;
  18:  ! R[10:Error Code]   shared fault code (set by subs) ;
  19:  ! R[20:RunStatus]    2=busy 1=ok 0=fault (out) ;
  20:  ! R[21:CurStation]   1=St1 2=St2 current station ;
  21:  ! R[22:CloseStatus]  CLOSE_OB status (in) ;
  22:  ! R[23:CloseStep]    CLOSE_OB internal step (reset) ;
  23:  ! R[25:PickStatus]   PICK_PBS status (in) ;
  24:  ! R[26:PickStep]     PICK_PBS internal step (reset) ;
  25:  ! R[59:TipStatus]    TIP_VERIFY status (in) ;
  26:  ! R[60:TipVfyStep]   TIP_VERIFY internal step (reset) ;
  27:  ! R[32:VisResult]    1=pass 2=no-go (in) ;
  28:  ! R[33:VisStatus]    VISION status (in) ;
  29:  ! R[34:VisStep]      VISION internal step (reset) ;
  30:  ! R[61:RetStatus]    RETURN_PBS status (in) ;
  31:  ! R[62:RetStep]      RETURN_PBS internal step (reset) ;
  32:  ! R[38:CtrStatus]    CENTER status (in) ;
  33:  ! R[39:CtrStep]      CENTER internal step (reset) ;
  34:  ! R[66:DispStatus]   DISPENSE status (in) ;
  35:  ! R[67:DispStep]     DISPENSE internal step (reset) ;
  36:  ! R[50:PlaceStatus]  PLACE_PBS status (in) ;
  37:  ! R[51:PlaceStep]    PLACE_PBS internal step (reset) ;
  38:  ! R[55:RelStatus]    RELEASE_OB status (in) ;
  39:  ! R[56:RelStep]      RELEASE_OB internal step (reset) ;
  40:  ! R[154:St1Status]   1=St1 active (in) ;
  41:  ! R[155:St2Status]   1=St2 active (in) ;
  42:  ! ;
  43:  ! No motion in RUN itself; subs own their frames. ;
  44:  ! Error codes 910-919 reserved for RUN-scope subs. ;
  45:   ;
  46:  R[20:RunStatus]=2 ;
  47:   ;
  48:  ! --- Dispatch on state --- ;
  49:  SELECT R[7:RUN_STEP]=0,JMP LBL[10] ;
  50:         =1,JMP LBL[20] ;
  51:         =2,JMP LBL[25] ;
  52:         =3,JMP LBL[30] ;
  53:         =4,JMP LBL[40] ;
  54:         =5,JMP LBL[45] ;
  55:         =6,JMP LBL[50] ;
  56:         =7,JMP LBL[55] ;
  57:         =8,JMP LBL[60] ;
  58:         =10,JMP LBL[75] ;
  59:         ELSE,JMP LBL[10] ;
  60:   ;
  61:   ;
  62:  ! ============================= ;
  63:  ! State 0: setup. Choose start station, ;
  64:  !          reset sub internals. ;
  65:  ! ============================= ;
  66:  LBL[10] ;
  67:  R[21:CurStation]=1 ;
  68:  IF R[154:St1Status]=1,JMP LBL[11] ;
  69:  R[21:CurStation]=2 ;
  70:  LBL[11] ;
  71:  R[23:CloseStep]=0 ;
  72:  R[26:PickStep]=0 ;
  73:  R[60:TipVfyStep]=0 ;
  74:  R[34:VisStep]=0 ;
  75:  R[62:RetStep]=0 ;
  76:  R[39:CtrStep]=0 ;
  77:  R[67:DispStep]=0 ;
  78:  R[51:PlaceStep]=0 ;
  79:  R[56:RelStep]=0 ;
  80:  R[7:RUN_STEP]=1 ;
  81:  JMP LBL[99] ;
  82:   ;
  83:   ;
  84:  ! ============================= ;
  85:  ! State 1: close active OB stations (once). ;
  86:  ! ============================= ;
  87:  LBL[20] ;
  88:  CALL CLOSE_OB ;
  89:  IF R[22:CloseStatus]=0,JMP LBL[88] ;
  90:  IF R[22:CloseStatus]<>1,JMP LBL[99] ;
  91:  ! CLOSE_OB ok -> tip verify. ;
  92:  R[7:RUN_STEP]=2 ;
  93:  JMP LBL[99] ;
  94:   ;
  95:   ;
  96:  ! ============================= ;
  97:  ! State 2: verify calibrated tip hits beams. ;
  98:  ! ============================= ;
  99:  LBL[25] ;
 100:  CALL TIP_VERIFY ;
 101:  IF R[59:TipStatus]=0,JMP LBL[88] ;
 102:  IF R[59:TipStatus]<>1,JMP LBL[99] ;
 103:  ! Tip verify ok -> pick. ;
 104:  R[7:RUN_STEP]=3 ;
 105:  JMP LBL[99] ;
 106:   ;
 107:   ;
 108:  ! ============================= ;
 109:  ! State 3: pick one PBS. ;
 110:  ! ============================= ;
 111:  LBL[30] ;
 112:  CALL PICK_PBS ;
 113:  IF R[25:PickStatus]=0,JMP LBL[88] ;
 114:  IF R[25:PickStatus]<>1,JMP LBL[99] ;
 115:  ! PICK ok -> inspect (camera). ;
 116:  R[7:RUN_STEP]=4 ;
 117:  JMP LBL[99] ;
 118:   ;
 119:   ;
 120:  ! ============================= ;
 121:  ! State 4: inspect PBS orientation (camera). ;
 122:  !  pass  -> 6 CENTER ;
 123:  !  no-go -> 5 RETURN_PBS, then back to 3 PICK ;
 124:  ! VISION sets its own UF1/UT3 on entry. ;
 125:  ! ============================= ;
 126:  LBL[40] ;
 127:  CALL VISION ;
 128:  IF R[33:VisStatus]=0,JMP LBL[88] ;
 129:  IF R[33:VisStatus]<>1,JMP LBL[99] ;
 130:  ! VISION done -> route on result ;
 131:  IF R[32:VisResult]=2,JMP LBL[41] ;
 132:  ! pass -> center ;
 133:  R[7:RUN_STEP]=6 ;
 134:  JMP LBL[99] ;
 135:  LBL[41] ;
 136:  ! no-go -> return PBS to its slot ;
 137:  R[7:RUN_STEP]=5 ;
 138:  JMP LBL[99] ;
 139:   ;
 140:   ;
 141:  ! ============================= ;
 142:  ! State 5: return no-go PBS to its tray slot, ;
 143:  !          then go back to PICK for next slot. ;
 144:  ! ============================= ;
 145:  LBL[45] ;
 146:  CALL RETURN_PBS ;
 147:  IF R[61:RetStatus]=0,JMP LBL[88] ;
 148:  IF R[61:RetStatus]<>1,JMP LBL[99] ;
 149:  ! Returned ok -> pick next slot. ;
 150:  R[7:RUN_STEP]=3 ;
 151:  JMP LBL[99] ;
 152:   ;
 153:   ;
 154:  ! ============================= ;
 155:  ! State 6: center the PBS (drop, push, re-pick). ;
 156:  !  ok -> 7 DISPENSE ;
 157:  ! ============================= ;
 158:  LBL[50] ;
 159:  CALL CENTER ;
 160:  IF R[38:CtrStatus]=0,JMP LBL[88] ;
 161:  IF R[38:CtrStatus]<>1,JMP LBL[99] ;
 162:  ! CENTER ok -> dispense glue on the OB. ;
 163:  R[7:RUN_STEP]=7 ;
 164:  JMP LBL[99] ;
 165:   ;
 166:   ;
 167:  ! ============================= ;
 168:  ! State 7: dispense glue onto current OB. ;
 169:  !  ok -> 8 PLACE ;
 170:  ! ============================= ;
 171:  LBL[55] ;
 172:  CALL DISPENSE ;
 173:  IF R[66:DispStatus]=0,JMP LBL[88] ;
 174:  IF R[66:DispStatus]<>1,JMP LBL[99] ;
 175:  ! DISPENSE ok -> place PBS on the OB. ;
 176:  R[7:RUN_STEP]=8 ;
 177:  JMP LBL[99] ;
 178:   ;
 179:   ;
 180:  ! ============================= ;
 181:  ! State 8: place PBS on OB + UV cure (holding). ;
 182:  !  ok -> 10 RELEASE_OB ;
 183:  ! ============================= ;
 184:  LBL[60] ;
 185:  CALL PLACE_PBS ;
 186:  IF R[50:PlaceStatus]=0,JMP LBL[88] ;
 187:  IF R[50:PlaceStatus]<>1,JMP LBL[99] ;
 188:  ! PLACE ok -> release the OB station(s). ;
 189:  R[7:RUN_STEP]=10 ;
 190:  JMP LBL[99] ;
 191:   ;
 192:   ;
 193:  ! ============================= ;
 194:  ! State 10: release both OB stations. ;
 195:  ! ============================= ;
 196:  LBL[75] ;
 197:  CALL RELEASE_OB ;
 198:  IF R[55:RelStatus]=0,JMP LBL[88] ;
 199:  IF R[55:RelStatus]<>1,JMP LBL[99] ;
 200:  ! RELEASE_OB ok -> DONE. ;
 201:  JMP LBL[80] ;
 202:   ;
 203:   ;
 204:  ! ============================= ;
 205:  ! DONE: all phases complete. ;
 206:  ! ============================= ;
 207:  LBL[80] ;
 208:  R[20:RunStatus]=1 ;
 209:  R[7:RUN_STEP]=0 ;
 210:  JMP LBL[99] ;
 211:   ;
 212:   ;
 213:  ! ============================= ;
 214:  ! Fault: status 0, reset steps. ;
 215:  ! ============================= ;
 216:  LBL[88] ;
 217:  R[20:RunStatus]=0 ;
 218:  R[60:TipVfyStep]=0 ;
 219:  R[34:VisStep]=0 ;
 220:  R[62:RetStep]=0 ;
 221:  R[39:CtrStep]=0 ;
 222:  R[67:DispStep]=0 ;
 223:  R[51:PlaceStep]=0 ;
 224:  R[56:RelStep]=0 ;
 225:  R[7:RUN_STEP]=0 ;
 226:  JMP LBL[99] ;
 227:   ;
 228:  LBL[99] ;
/POS
/END
