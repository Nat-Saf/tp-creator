/PROG  CLOSE_OB
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Close OB";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-05  TIME 13:00:00;
MODIFIED	= DATE 26-07-05  TIME 15:55:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/MN
   1:  ! === CLOSE_OB === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Closes active OB stations for RUN prep. ;
   4:  ! Order: ROTATE first, then CLAMP. ;
   5:  ! Acts on active stations only (R[154]/R[155]=1), ;
   6:  ! read LIVE each scan. No motion (DO/DI only). ;
   7:  ! Main air presence guarded by INIT+MONITOR. ;
   8:  ! ;
   9:  ! Sensors checked EACH scan; advance the instant ;
  10:  ! all active stations confirm. Timeout only faults. ;
  11:  ! ;
  12:  ! States (R[23:CloseStep]): ;
  13:  !  0 = guard, confirm open, rotate ON, timer ;
  14:  !  1 = wait rotate confirm, clamp ON, timer ;
  15:  !  2 = wait clamp confirm, done ;
  16:  ! ;
  17:  ! Registers: ;
  18:  ! R[10:Error Code]   shared fault code (out) ;
  19:  ! R[14:PistTimeout]  clamp settle timeout sec (in) ;
  20:  ! R[24:RotateTO]     rotate settle timeout sec (in) ;
  21:  ! R[22:CloseStatus]  2=busy 1=ok 0=fault (out) ;
  22:  ! R[23:CloseStep]    internal state 0-2 ;
  23:  ! R[122:PistElapsed] timer readback scratch ;
  24:  ! R[154:St1Status]   1=St1 active (in) ;
  25:  ! R[155:St2Status]   1=St2 active (in) ;
  26:  ! ;
  27:  ! DO[1375] St1 rotate   DO[1379] St2 rotate ;
  28:  ! DO[1373] St1 clamp    DO[1377] St2 clamp ;
  29:  ! DI[402]  St1 induct   DI[434]  St2 induct ;
  30:  ! DI[400]  St1 clampUp  DI[401]  St1 clampDn ;
  31:  ! DI[432]  St2 clampUp  DI[433]  St2 clampDn ;
  32:  ! TIMER[2] shared RUN-phase timer. ;
  33:  ! ;
  34:  ! Error codes: ;
  35:  ! 920 = no OB station active on entry ;
  36:  ! 921 = St1 rotate FAIL (timeout, inductive ON) ;
  37:  ! 922 = St2 rotate FAIL ;
  38:  ! 923 = St1 clamp FAIL (timeout, Up/Down wrong) ;
  39:  ! 924 = St2 clamp FAIL ;
  40:  ! 925 = St1 not open/rest at start ;
  41:  ! 926 = St2 not open/rest at start ;
  42:   ;
  43:  R[22:CloseStatus]=2 ;
  44:   ;
  45:  ! --- Dispatch on state --- ;
  46:  SELECT R[23:CloseStep]=0,JMP LBL[10] ;
  47:         =1,JMP LBL[20] ;
  48:         =2,JMP LBL[30] ;
  49:         ELSE,JMP LBL[10] ;
  50:   ;
  51:   ;
  52:  ! ============================= ;
  53:  ! State 0: guard, confirm stations open, ;
  54:  !          command rotate ON, start timer ;
  55:  ! ============================= ;
  56:  LBL[10] ;
  57:  ! Guard: at least one station must be active ;
  58:  IF R[154:St1Status]=1,JMP LBL[11] ;
  59:  IF R[155:St2Status]=1,JMP LBL[11] ;
  60:  R[10:Error Code]=920 ;
  61:  CALL SET_STR('No OB station',10) ;
  62:  JMP LBL[88] ;
  63:  LBL[11] ;
  64:   ;
  65:  ! Confirm St1 open: induct ON, clamp Up ON/Dn OFF ;
  66:  IF R[154:St1Status]<>1,JMP LBL[15] ;
  67:  IF DI[402:X2.2 St1 Inductive]<>ON,JMP LBL[14] ;
  68:  IF DI[400:X2.0 St1 Clamp Up]<>ON,JMP LBL[14] ;
  69:  IF DI[401:X2.1 St1 Clamp Down]<>OFF,JMP LBL[14] ;
  70:  JMP LBL[15] ;
  71:  LBL[14] ;
  72:  R[10:Error Code]=925 ;
  73:  CALL SET_STR('St1 not open',10) ;
  74:  JMP LBL[88] ;
  75:  LBL[15] ;
  76:   ;
  77:  ! Confirm St2 open: induct ON, clamp Up ON/Dn OFF ;
  78:  IF R[155:St2Status]<>1,JMP LBL[17] ;
  79:  IF DI[434:X3.2 St2 inductive]<>ON,JMP LBL[16] ;
  80:  IF DI[432:X3.0 St2 Clamp Up]<>ON,JMP LBL[16] ;
  81:  IF DI[433:X3.1 St2 Clamp Down]<>OFF,JMP LBL[16] ;
  82:  JMP LBL[17] ;
  83:  LBL[16] ;
  84:  R[10:Error Code]=926 ;
  85:  CALL SET_STR('St2 not open',10) ;
  86:  JMP LBL[88] ;
  87:  LBL[17] ;
  88:   ;
  89:  ! Command rotate ON (active only) ;
  90:  IF R[154:St1Status]<>1,JMP LBL[18] ;
  91:  DO[1375:M7- St1 OBRotatingPisto]=ON ;
  92:  LBL[18] ;
  93:  IF R[155:St2Status]<>1,JMP LBL[19] ;
  94:  DO[1379:M11-St2 OBRotatingPiston]=ON ;
  95:  LBL[19] ;
  96:   ;
  97:  TIMER[2]=RESET ;
  98:  TIMER[2]=START ;
  99:  R[23:CloseStep]=1 ;
 100:  JMP LBL[99] ;
 101:   ;
 102:   ;
 103:  ! ============================= ;
 104:  ! State 1: wait rotate confirm (inductive OFF on ;
 105:  !          all active), then clamp ON. Timeout ;
 106:  !          R[24:RotateTO] -> fault. ;
 107:  ! ============================= ;
 108:  LBL[20] ;
 109:  ! Rotated? inductive OFF on all active stations ;
 110:  IF R[154:St1Status]<>1,JMP LBL[21] ;
 111:  IF DI[402:X2.2 St1 Inductive]=ON,JMP LBL[26] ;
 112:  LBL[21] ;
 113:  IF R[155:St2Status]<>1,JMP LBL[22] ;
 114:  IF DI[434:X3.2 St2 inductive]=ON,JMP LBL[26] ;
 115:  LBL[22] ;
 116:   ;
 117:  ! All active rotated -> command clamp ON ;
 118:  IF R[154:St1Status]<>1,JMP LBL[23] ;
 119:  DO[1373:M5 - St1 OB Clamp ACT]=ON ;
 120:  LBL[23] ;
 121:  IF R[155:St2Status]<>1,JMP LBL[24] ;
 122:  DO[1377:M9 - St2 OBClampPisto]=ON ;
 123:  LBL[24] ;
 124:  TIMER[2]=RESET ;
 125:  TIMER[2]=START ;
 126:  R[23:CloseStep]=2 ;
 127:  JMP LBL[99] ;
 128:   ;
 129:  ! Not all rotated: wait unless timeout ;
 130:  LBL[26] ;
 131:  R[122:PistElapsed]=TIMER[2] ;
 132:  IF R[122:PistElapsed]<R[24:RotateTO],JMP LBL[99] ;
 133:  ! Timeout: identify failed station ;
 134:  IF R[154:St1Status]<>1,JMP LBL[27] ;
 135:  IF DI[402:X2.2 St1 Inductive]=OFF,JMP LBL[27] ;
 136:  R[10:Error Code]=921 ;
 137:  CALL SET_STR('St1 rotate FAIL',10) ;
 138:  JMP LBL[88] ;
 139:  LBL[27] ;
 140:  R[10:Error Code]=922 ;
 141:  CALL SET_STR('St2 rotate FAIL',10) ;
 142:  JMP LBL[88] ;
 143:   ;
 144:   ;
 145:  ! ============================= ;
 146:  ! State 2: wait clamp confirm (Up OFF AND Down ON ;
 147:  !          on all active). Timeout R[14:PistTimeout] ;
 148:  !          -> fault. ;
 149:  ! ============================= ;
 150:  LBL[30] ;
 151:  ! Clamped? Up OFF AND Down ON on all active ;
 152:  IF R[154:St1Status]<>1,JMP LBL[31] ;
 153:  IF DI[400:X2.0 St1 Clamp Up]<>OFF,JMP LBL[36] ;
 154:  IF DI[401:X2.1 St1 Clamp Down]<>ON,JMP LBL[36] ;
 155:  LBL[31] ;
 156:  IF R[155:St2Status]<>1,JMP LBL[32] ;
 157:  IF DI[432:X3.0 St2 Clamp Up]<>OFF,JMP LBL[36] ;
 158:  IF DI[433:X3.1 St2 Clamp Down]<>ON,JMP LBL[36] ;
 159:  LBL[32] ;
 160:   ;
 161:  ! All active clamped -> done ;
 162:  TIMER[2]=STOP ;
 163:  R[10:Error Code]=0 ;
 164:  CALL SET_STR('CloseOB OK',10) ;
 165:  R[22:CloseStatus]=1 ;
 166:  R[23:CloseStep]=0 ;
 167:  JMP LBL[99] ;
 168:   ;
 169:  ! Not all clamped: wait unless timeout ;
 170:  LBL[36] ;
 171:  R[122:PistElapsed]=TIMER[2] ;
 172:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
 173:  ! Timeout: identify failed station ;
 174:  IF R[154:St1Status]<>1,JMP LBL[37] ;
 175:  IF DI[400:X2.0 St1 Clamp Up]<>OFF,JMP LBL[38] ;
 176:  IF DI[401:X2.1 St1 Clamp Down]<>ON,JMP LBL[38] ;
 177:  JMP LBL[37] ;
 178:  LBL[38] ;
 179:  R[10:Error Code]=923 ;
 180:  CALL SET_STR('St1 clamp FAIL',10) ;
 181:  JMP LBL[88] ;
 182:  LBL[37] ;
 183:  R[10:Error Code]=924 ;
 184:  CALL SET_STR('St2 clamp FAIL',10) ;
 185:  JMP LBL[88] ;
 186:   ;
 187:   ;
 188:  ! ============================= ;
 189:  ! Fault: set status 0, reset state ;
 190:  ! ============================= ;
 191:  LBL[88] ;
 192:  TIMER[2]=STOP ;
 193:  R[22:CloseStatus]=0 ;
 194:  R[23:CloseStep]=0 ;
 195:  JMP LBL[99] ;
 196:   ;
 197:  LBL[99] ;
/POS
/END
