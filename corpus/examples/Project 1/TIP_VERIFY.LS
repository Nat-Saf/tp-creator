/PROG  TIP_VERIFY
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Tip verify";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-06  TIME 12:00:00;
MODIFIED	= DATE 26-07-06  TIME 14:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/MN
   1:  ! === TIP_VERIFY === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Called by RUN right after CLOSE_OB. ;
   4:  ! ;
   5:  ! Replays PR[6:TipPos], which CALIB_NEEDLE State 7 ;
   6:  ! captured as LPOS with UTOOL[1] active right after ;
   7:  ! the tool update (robot on the crossing). Point + ;
   8:  ! tool are a matched pair, so L PR[6] with UT1 puts ;
   9:  ! the tip back on the crossing. If the needle moved ;
  10:  ! since calib, beams won't both block -> fault 911. ;
  11:  ! No PR[4]/PR[3] math, no delta - cannot drift. ;
  12:  ! Frame UFRAME_NUM=1, UTOOL_NUM=1. ;
  13:  ! ;
  14:  ! States (R[60:TipVfyStep]): ;
  15:  !  0 = precheck, approach above crossing (up) ;
  16:  !  1 = lower needle, start timer ;
  17:  !  2 = wait needle DOWN (DI[369]) ;
  18:  !  3 = descend to crossing, start 3 s hold ;
  19:  !  4 = verify both beams ON, hold 3 s ;
  20:  !  5 = retract to approach, raise needle ;
  21:  !  6 = wait needle UP (DI[368]), report OK ;
  22:  ! ;
  23:  ! Registers: ;
  24:  ! R[10:Error Code]    shared fault code (out) ;
  25:  ! R[14:PistTimeout]   piston move timeout seconds ;
  26:  ! R[60:TipVfyStep]    internal step 0-6 ;
  27:  ! R[59:TipStatus]     2=busy 1=ok 0=fault (out) ;
  28:  ! R[122:PistElapsed]  timer readback scratch ;
  29:  ! R[126:RefSet]       0=no calib ref  1=ref stored ;
  30:  ! ;
  31:  ! Position registers: ;
  32:  ! PR[6:TipPos]        calibrated crossing pose (in) ;
  33:  ! PR[9:ZOffset]       Z approach/retract clearance (preset) ;
  34:  ! ;
  35:  ! I/O: ;
  36:  ! DI[368] disp piston UP    DI[369] disp piston DOWN ;
  37:  ! DI[435] X-beam            DI[436] Y-beam ;
  38:  ! DO[372] disp piston ACT (ON=down OFF=up) ;
  39:  ! TIMER[2] shared RUN-phase timer. ;
  40:  ! ;
  41:  ! Error codes: ;
  42:  ! 910 = not calibrated (R[126]=0) ;
  43:  ! 911 = beams not both blocked at crossing ;
  44:  ! 912 = needle down timeout ;
  45:  ! 913 = needle up timeout ;
  46:   ;
  47:  R[59:TipStatus]=2 ;
  48:   ;
  49:  ! --- Dispatch on state --- ;
  50:  SELECT R[60:TipVfyStep]=0,JMP LBL[10] ;
  51:         =1,JMP LBL[20] ;
  52:         =2,JMP LBL[30] ;
  53:         =3,JMP LBL[40] ;
  54:         =4,JMP LBL[50] ;
  55:         =5,JMP LBL[60] ;
  56:         =6,JMP LBL[70] ;
  57:         ELSE,JMP LBL[10] ;
  58:   ;
  59:   ;
  60:  ! ============================= ;
  61:  ! State 0: precheck, approach above crossing ;
  62:  ! ============================= ;
  63:  LBL[10] ;
  64:  UFRAME_NUM=1 ;
  65:  UTOOL_NUM=1 ;
  66:  ! Guard: calibration must have run (fills PR[6]) ;
  67:  IF R[126:RefSet]=1,JMP LBL[11] ;
  68:  R[10:Error Code]=910 ;
  69:  CALL SET_STR('Tip not calibrated',10) ;
  70:  JMP LBL[88] ;
  71:  LBL[11] ;
  72:  ! Approach above crossing (needle up) ;
  73:L PR[6:TipPos] R[63:TravelSpd]mm/sec CNT50 Offset,PR[9]    ;
  74:  R[60:TipVfyStep]=1 ;
  75:  JMP LBL[99] ;
  76:   ;
  77:  ! ============================= ;
  78:  ! State 1: lower needle, start timer ;
  79:  ! ============================= ;
  80:  LBL[20] ;
  81:  DO[372:X1.4Gripper.DisPistonACT]=ON ;
  82:  TIMER[2]=RESET ;
  83:  TIMER[2]=START ;
  84:  R[60:TipVfyStep]=2 ;
  85:  JMP LBL[99] ;
  86:   ;
  87:  ! ============================= ;
  88:  ! State 2: wait needle DOWN (DI[369]) ;
  89:  ! ============================= ;
  90:  LBL[30] ;
  91:  IF DI[369:X1.1 DispPistonDown]=ON,JMP LBL[32] ;
  92:  R[122:PistElapsed]=TIMER[2] ;
  93:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
  94:  R[10:Error Code]=912 ;
  95:  CALL SET_STR('Tip needle dn FAIL',10) ;
  96:  JMP LBL[88] ;
  97:  LBL[32] ;
  98:  TIMER[2]=STOP ;
  99:  R[60:TipVfyStep]=3 ;
 100:  JMP LBL[99] ;
 101:   ;
 102:  ! ============================= ;
 103:  ! State 3: descend to crossing, start 3 s hold ;
 104:  ! ============================= ;
 105:  LBL[40] ;
 106:L PR[6:TipPos] R[64:PrecSpd]mm/sec FINE    ;
 107:  TIMER[2]=RESET ;
 108:  TIMER[2]=START ;
 109:  R[60:TipVfyStep]=4 ;
 110:  JMP LBL[99] ;
 111:   ;
 112:  ! ============================= ;
 113:  ! State 4: verify both beams ON, hold 3 s ;
 114:  ! ============================= ;
 115:  LBL[50] ;
 116:  IF DI[435:X3.3-X Tip Calibration]=OFF,JMP LBL[52] ;
 117:  IF DI[436:X3.4-Y Tip Calibration]=OFF,JMP LBL[52] ;
 118:  R[122:PistElapsed]=TIMER[2] ;
 119:  IF R[122:PistElapsed]<3,JMP LBL[99] ;
 120:  TIMER[2]=STOP ;
 121:  R[60:TipVfyStep]=5 ;
 122:  JMP LBL[99] ;
 123:  LBL[52] ;
 124:  R[10:Error Code]=911 ;
 125:  CALL SET_STR('Tip verify FAIL',10) ;
 126:  JMP LBL[88] ;
 127:   ;
 128:  ! ============================= ;
 129:  ! State 5: retract to approach, raise needle ;
 130:  ! ============================= ;
 131:  LBL[60] ;
 132:L PR[6:TipPos] R[63:TravelSpd]mm/sec CNT50 Offset,PR[9]    ;
 133:  DO[372:X1.4Gripper.DisPistonACT]=OFF ;
 134:  TIMER[2]=RESET ;
 135:  TIMER[2]=START ;
 136:  R[60:TipVfyStep]=6 ;
 137:  JMP LBL[99] ;
 138:   ;
 139:  ! ============================= ;
 140:  ! State 6: wait needle UP (DI[368]), report OK ;
 141:  ! ============================= ;
 142:  LBL[70] ;
 143:  IF DI[368:X1.0 DispPistonUp]=ON,JMP LBL[72] ;
 144:  R[122:PistElapsed]=TIMER[2] ;
 145:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[99] ;
 146:  R[10:Error Code]=913 ;
 147:  CALL SET_STR('Tip needle up FAIL',10) ;
 148:  JMP LBL[88] ;
 149:  LBL[72] ;
 150:  TIMER[2]=STOP ;
 151:  R[10:Error Code]=0 ;
 152:  CALL SET_STR('Tip verify OK',10) ;
 153:  R[59:TipStatus]=1 ;
 154:  R[60:TipVfyStep]=0 ;
 155:  JMP LBL[99] ;
 156:   ;
 157:   ;
 158:  ! ============================= ;
 159:  ! Fault: status 0, reset step. ;
 160:  ! Needle left as-is (manual/ERROR recovery). ;
 161:  ! ============================= ;
 162:  LBL[88] ;
 163:  TIMER[2]=STOP ;
 164:  R[59:TipStatus]=0 ;
 165:  R[60:TipVfyStep]=0 ;
 166:  JMP LBL[99] ;
 167:   ;
 168:  LBL[99] ;
/POS
/END
