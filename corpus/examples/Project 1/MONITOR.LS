/PROG  MONITOR
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Cont monitor";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-24  TIME 12:00:00;
MODIFIED	= DATE 26-07-06  TIME 16:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/MN
   1:  ! === MONITOR === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Called at top of every MAIN loop pass. ;
   4:  ! Sec 0: cell-wide checks (ALL states). ;
   5:  ! Sec 1: tray edge detection. ;
   6:  ! Sec 2: station safety (RUN only, not release). ;
   7:  ! MONITOR only SETS R[10]/SR[10]; ;
   8:  ! MAIN/INIT clear R[10] on restart/ack. ;
   9:  ! ERROR sub does hardware cleanup. ;
  10:   ;
  11:  ! Registers used: ;
  12:  ! R[1:MODE_ACT]    current MAIN state (4=RUN) ;
  13:  ! R[7:RUN_STEP]    RUN sub-state (10=OB release) ;
  14:  ! R[10:Error Code] shared fault code (out) ;
  15:  ! R[153:TrayFull]  1=PBS remaining in tray ;
  16:  ! R[154:St1Status] 0=empty 1=OK ;
  17:  ! R[155:St2Status] 0=empty 1=OK ;
  18:  ! R[156:PBSPickX]  current X pick index ;
  19:  ! R[157:PBSPickY]  current Y pick index ;
  20:  ! R[160:TrayPrev]  DI[592] previous scan latch ;
  21:   ;
  22:  ! DI[439] Main air sensor ;
  23:  ! DI[592] PBS tray in ;
  24:  ! DI[560] St1 OB sensor ;
  25:  ! DI[404] St1 vacuum reached ;
  26:  ! DI[528] St2 OB sensor ;
  27:  ! DI[469] St2 vacuum reached ;
  28:  ! DI[TBD] UV unit error (commented out) ;
  29:   ;
  30:  ! Error codes: ;
  31:  ! 903 = tray removed during RUN ;
  32:  ! 904 = St1 OB sensor lost during RUN ;
  33:  ! 905 = St1 vacuum lost during RUN ;
  34:  ! 906 = St2 OB sensor lost during RUN ;
  35:  ! 907 = St2 vacuum lost during RUN ;
  36:  ! 908 = UV unit error (all states) [TBD] ;
  37:  ! 909 = air lost (all states) ;
  38:  ! (904-907 suppressed while RUN_STEP=10 release) ;
  39:   ;
  40:  ! ============================= ;
  41:  ! Section 0: cell-wide checks (all states) ;
  42:  ! Set-only. In RUN, also short-circuit LBL[88]. ;
  43:  ! First fault wins (guarded by R[10]=0). ;
  44:  ! Recovery: MAIN ack/restart -> INIT rechecks air. ;
  45:  ! ============================= ;
  46:   ;
  47:  ! --- Main air supply --- ;
  48:  IF DI[439:X3.7 Main Air Sensor]=ON,JMP LBL[5] ;
  49:  IF R[10:Error Code]<>0,JMP LBL[4] ;
  50:  R[10:Error Code]=909 ;
  51:  CALL SET_STR('Air lost',10) ;
  52:  LBL[4] ;
  53:  IF R[1:MODE_ACT]=4,JMP LBL[88] ;
  54:  LBL[5] ;
  55:   ;
  56:  ! --- UV unit error (enable when DI known) --- ;
  57:  ! IF DI[TBD UV error]=OFF,JMP LBL[7] ;
  58:  ! IF R[10:Error Code]<>0,JMP LBL[6] ;
  59:  ! R[10:Error Code]=908 ;
  60:  ! CALL SET_STR('UV unit error',10) ;
  61:  ! LBL[6] ;
  62:  ! IF R[1:MODE_ACT]=4,JMP LBL[88] ;
  63:  ! LBL[7] ;
  64:   ;
  65:  ! ============================= ;
  66:  ! Section 1: Tray checks ;
  67:  ! ============================= ;
  68:   ;
  69:  ! --- Tray removed during RUN -> immediate fault --- ;
  70:  IF R[1:MODE_ACT]<>4,JMP LBL[10] ;
  71:  IF DI[592:X8.0 PBS tray in]=ON,JMP LBL[10] ;
  72:  R[10:Error Code]=903 ;
  73:  CALL SET_STR('Tray removed-RUN',10) ;
  74:  JMP LBL[88] ;
  75:  LBL[10] ;
  76:   ;
  77:  ! --- Tray falling edge (not in RUN) --- ;
  78:  ! Tray removed outside RUN: clear counters so ;
  79:  ! next tray starts from slot 0. ;
  80:  IF R[1:MODE_ACT]=4,JMP LBL[20] ;
  81:  IF R[160:TrayPrev]<>1,JMP LBL[20] ;
  82:  IF DI[592:X8.0 PBS tray in]=ON,JMP LBL[20] ;
  83:  ! Falling edge detected ;
  84:  R[153:TrayFull]=0 ;
  85:  R[156:PBSPickX]=0 ;
  86:  R[157:PBSPickY]=0 ;
  87:  LBL[20] ;
  88:   ;
  89:  ! --- Tray rising edge (any state) --- ;
  90:  ! New tray inserted: reset counters, mark full. ;
  91:  IF R[160:TrayPrev]<>0,JMP LBL[30] ;
  92:  IF DI[592:X8.0 PBS tray in]<>ON,JMP LBL[30] ;
  93:  ! Rising edge detected ;
  94:  R[153:TrayFull]=1 ;
  95:  R[156:PBSPickX]=0 ;
  96:  R[157:PBSPickY]=0 ;
  97:  LBL[30] ;
  98:   ;
  99:  ! --- Update edge latch for next scan --- ;
 100:  IF DI[592:X8.0 PBS tray in]=ON,JMP LBL[35] ;
 101:  R[160:TrayPrev]=0 ;
 102:  JMP LBL[36] ;
 103:  LBL[35] ;
 104:  R[160:TrayPrev]=1 ;
 105:  LBL[36] ;
 106:   ;
 107:  ! ============================= ;
 108:  ! Section 2: Station safety (RUN only) ;
 109:  ! ============================= ;
 110:   ;
 111:  IF R[1:MODE_ACT]<>4,JMP LBL[99] ;
 112:   ;
 113:  ! --- Skip during OB release (RUN_STEP 10) --- ;
 114:  ! RELEASE_OB intentionally drops station vacuum ;
 115:  ! and ejects the OB; sensors going OFF here is ;
 116:  ! expected, not a fault. ;
 117:  IF R[7:RUN_STEP]=10,JMP LBL[99] ;
 118:   ;
 119:  ! --- Station 1 checks (only if active) --- ;
 120:  IF R[154:St1Status]<>1,JMP LBL[50] ;
 121:  IF DI[560:X7.0 St1 OB sensor]=ON,JMP LBL[42] ;
 122:  R[10:Error Code]=904 ;
 123:  CALL SET_STR('St1 OB lost-RUN',10) ;
 124:  JMP LBL[88] ;
 125:  LBL[42] ;
 126:  IF DI[404:X2.4 St1 Vacuum Reached]=ON,JMP LBL[50] ;
 127:  R[10:Error Code]=905 ;
 128:  CALL SET_STR('St1 Vac lost-RUN',10) ;
 129:  JMP LBL[88] ;
 130:  LBL[50] ;
 131:   ;
 132:  ! --- Station 2 checks (only if active) --- ;
 133:  IF R[155:St2Status]<>1,JMP LBL[99] ;
 134:  IF DI[528:X6.0 St2 OB sensor]=ON,JMP LBL[62] ;
 135:  R[10:Error Code]=906 ;
 136:  CALL SET_STR('St2 OB lost-RUN',10) ;
 137:  JMP LBL[88] ;
 138:  LBL[62] ;
 139:  IF DI[469:X4.5 St2 Vacuum Reached]=ON,JMP LBL[99] ;
 140:  R[10:Error Code]=907 ;
 141:  CALL SET_STR('St2 Vac lost-RUN',10) ;
 142:  JMP LBL[88] ;
 143:   ;
 144:  ! ============================= ;
 145:  ! Fault exit ;
 146:  ! ============================= ;
 147:  LBL[88] ;
 148:  ! ERROR sub handles hardware cleanup. ;
 149:  ! MAIN detects R[10]<>0 and routes to ERROR. ;
 150:   ;
 151:  LBL[99] ;
/POS
/END
