/PROG  STANDBY
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Standby OB load";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-24  TIME 12:00:00;
MODIFIED	= DATE 26-07-05  TIME 16:30:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/APPL
/MN
   1:  ! === STANDBY === ;
   2:  ! Step-per-scan: ONE pass per call. ;
   3:  ! Called by MAIN when R[1:MODE_ACT]=2. ;
   4:  ! ;
   5:  ! Station load step (R[163]/R[164]): ;
   6:  !  0 = idle (OB sensor OFF or reset) ;
   7:  !  1 = vac ON, waiting DI[404] settle ;
   8:  !  2 = confirmed (station ready) ;
   9:  !  3 = vacuum break air pulse ;
   10:  !  4 = eject air pulse ;
   11:  ! ;
   12:  ! Station status (R[154]/R[155]): ;
   13:  !  0 = empty / not ready ;
   14:  !  1 = OB loaded, vacuum confirmed ;
   15:  ! ;
   16:  ! Registers: ;
   17:  ! R[14:PistTimeout]    eject pulse duration sec ;
   18:  ! R[122:PistElapsed]   timer readback scratch ;
   19:  ! R[151:Ready]         1=all conditions met ;
   20:  ! R[152:TraysReady]    1=tray present and full ;
   21:  ! R[153:TrayFull]      1=PBS remaining ;
   22:  ! R[154:St1Status]     0=not ready 1=OK ;
   23:  ! R[155:St2Status]     0=not ready 1=OK ;
   24:  ! R[163:St1LoadStep]   St1 internal state 0-4 ;
   25:  ! R[164:St2LoadStep]   St2 internal state 0-4 ;
   26:  ! R[165:St1EjectCmd]   operator sets 1 to eject ;
   27:  ! R[166:St2EjectCmd]   operator sets 1 to eject ;
   28:  ! R[168:VacSettleTime] vac reached settle sec ;
   29:  ! R[169:VacBreakTime]  vac break pulse sec ;
   30:  ! ;
   31:  ! DI[560] St1 OB sensor ;
   32:  ! DI[404] St1 vacuum reached ;
   33:  ! DI[528] St2 OB sensor ;
   34:  ! DI[469] St2 vacuum reached ;
   35:  ! DI[592] PBS tray in ;
   36:  ! DO[406] St1 vacuum ACT ;
   37:  ! DO[470] St2 vacuum ACT ;
   38:  ! DO[407] St1 air push - eject and vac break ;
   39:  ! DO[471] St2 air push - eject and vac break ;
   40:  ! TIMER[2] St1 timer ;
   41:  ! TIMER[3] St2 timer ;
   42:   ;
   43:   ;
   44:  ! ============================= ;
   45:  ! STATION 1 ;
   46:  ! ============================= ;
   47:   ;
   48:  ! --- Eject (highest priority) --- ;
   49:  IF R[165:St1EjectCmd]<>1,JMP LBL[11] ;
   50:  IF R[163:St1LoadStep]=4,JMP LBL[11] ;
   51:  DO[406:X2.6 St1 Vacuum ACT]=OFF ;
   52:  ! DO[407:X2.7 St1 AirPush ACT]=ON ;
   53:  TIMER[2]=RESET ;
   54:  TIMER[2]=START ;
   55:  R[154:St1Status]=0 ;
   56:  R[163:St1LoadStep]=4 ;
   57:  R[165:St1EjectCmd]=0 ;
   58:  LBL[11] ;
   59:   ;
   60:  ! --- Step 4: eject pulse running --- ;
   61:  IF R[163:St1LoadStep]<>4,JMP LBL[12] ;
   62:  R[122:PistElapsed]=TIMER[2] ;
   63:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[19] ;
   64:  TIMER[2]=STOP ;
   65:  ! DO[407:X2.7 St1 AirPush ACT]=OFF ;
   66:  R[163:St1LoadStep]=0 ;
   67:  JMP LBL[19] ;
   68:  LBL[12] ;
   69:   ;
   70:  ! --- Step 3: vacuum break pulse running --- ;
   71:  IF R[163:St1LoadStep]<>3,JMP LBL[13] ;
   72:  R[122:PistElapsed]=TIMER[2] ;
   73:  IF R[122:PistElapsed]<R[169:VacBreakTime],JMP LBL[19] ;
   74:  TIMER[2]=STOP ;
   75:  ! DO[407:X2.7 St1 AirPush ACT]=OFF ;
   76:  R[163:St1LoadStep]=0 ;
   77:  JMP LBL[19] ;
   78:  LBL[13] ;
   79:   ;
   80:  ! --- OB sensor OFF: reset everything --- ;
   81:  IF DI[560:X7.0 St1 OB sensor]=ON,JMP LBL[14] ;
   82:  DO[406:X2.6 St1 Vacuum ACT]=OFF ;
   83:  R[154:St1Status]=0 ;
   84:  R[163:St1LoadStep]=0 ;
   85:  JMP LBL[19] ;
   86:  LBL[14] ;
   87:   ;
   88:  ! --- OB sensor ON, step=0: activate vacuum --- ;
   89:  IF R[163:St1LoadStep]<>0,JMP LBL[15] ;
   90:  DO[406:X2.6 St1 Vacuum ACT]=ON ;
   91:  TIMER[2]=RESET ;
   92:  TIMER[2]=START ;
   93:  R[163:St1LoadStep]=1 ;
   94:  JMP LBL[19] ;
   95:  LBL[15] ;
   96:   ;
   97:  ! --- Step 1: waiting for DI[404] settle --- ;
   98:  ! DI[404] OFF: reset timer (flicker protection) ;
   99:  ! DI[404] ON: check settle timer ;
 100:  IF R[163:St1LoadStep]<>1,JMP LBL[16] ;
 101:  IF DI[404:X2.4 St1 Vacuum Reached]=ON,JMP LBL[17] ;
 102:  TIMER[2]=RESET ;
 103:  TIMER[2]=START ;
 104:  JMP LBL[19] ;
 105:  LBL[17] ;
 106:  R[122:PistElapsed]=TIMER[2] ;
 107:  IF R[122:PistElapsed]<R[168:VacSettleTime],JMP LBL[19] ;
 108:  ! Settle passed: station confirmed ;
 109:  TIMER[2]=STOP ;
 110:  R[154:St1Status]=1 ;
 111:  R[163:St1LoadStep]=2 ;
 112:  JMP LBL[19] ;
 113:  LBL[16] ;
 114:   ;
 115:  ! --- Step 2: confirmed, monitor DI[404] --- ;
 116:  IF R[163:St1LoadStep]<>2,JMP LBL[19] ;
 117:  IF DI[404:X2.4 St1 Vacuum Reached]=ON,JMP LBL[19] ;
 118:  ! DI[404] lost: start vacuum break ;
 119:  DO[406:X2.6 St1 Vacuum ACT]=OFF ;
 120:  ! DO[407:X2.7 St1 AirPush ACT]=ON ;
 121:  TIMER[2]=RESET ;
 122:  TIMER[2]=START ;
 123:  R[154:St1Status]=0 ;
 124:  R[163:St1LoadStep]=3 ;
 125:  LBL[19] ;
 126:   ;
 127:   ;
 128:  ! ============================= ;
 129:  ! STATION 2 ;
 130:  ! ============================= ;
 131:   ;
 132:  ! --- Eject (highest priority) --- ;
 133:  IF R[166:St2EjectCmd]<>1,JMP LBL[21] ;
 134:  IF R[164:St2LoadStep]=4,JMP LBL[21] ;
 135:  DO[470:X4.6 St2 Vacuum ACT]=OFF ;
 136:  ! DO[471:X4.7 St2 AirPush ACT]=ON ;
 137:  TIMER[3]=RESET ;
 138:  TIMER[3]=START ;
 139:  R[155:St2Status]=0 ;
 140:  R[164:St2LoadStep]=4 ;
 141:  R[166:St2EjectCmd]=0 ;
 142:  LBL[21] ;
 143:   ;
 144:  ! --- Step 4: eject pulse running --- ;
 145:  IF R[164:St2LoadStep]<>4,JMP LBL[22] ;
 146:  R[122:PistElapsed]=TIMER[3] ;
 147:  IF R[122:PistElapsed]<R[14:PistTimeout],JMP LBL[29] ;
 148:  TIMER[3]=STOP ;
 149:  ! DO[471:X4.7 St2 AirPush ACT]=OFF ;
 150:  R[164:St2LoadStep]=0 ;
 151:  JMP LBL[29] ;
 152:  LBL[22] ;
 153:   ;
 154:  ! --- Step 3: vacuum break pulse running --- ;
 155:  IF R[164:St2LoadStep]<>3,JMP LBL[23] ;
 156:  R[122:PistElapsed]=TIMER[3] ;
 157:  IF R[122:PistElapsed]<R[169:VacBreakTime],JMP LBL[29] ;
 158:  TIMER[3]=STOP ;
 159:  ! DO[471:X4.7 St2 AirPush ACT]=OFF ;
 160:  R[164:St2LoadStep]=0 ;
 161:  JMP LBL[29] ;
 162:  LBL[23] ;
 163:   ;
 164:  ! --- OB sensor OFF: reset everything --- ;
 165:  IF DI[528:X6.0 St2 OB sensor]=ON,JMP LBL[24] ;
 166:  DO[470:X4.6 St2 Vacuum ACT]=OFF ;
 167:  R[155:St2Status]=0 ;
 168:  R[164:St2LoadStep]=0 ;
 169:  JMP LBL[29] ;
 170:  LBL[24] ;
 171:   ;
 172:  ! --- OB sensor ON, step=0: activate vacuum --- ;
 173:  IF R[164:St2LoadStep]<>0,JMP LBL[25] ;
 174:  DO[470:X4.6 St2 Vacuum ACT]=ON ;
 175:  TIMER[3]=RESET ;
 176:  TIMER[3]=START ;
 177:  R[164:St2LoadStep]=1 ;
 178:  JMP LBL[29] ;
 179:  LBL[25] ;
 180:   ;
 181:  ! --- Step 1: waiting for DI[405] settle --- ;
 182:  ! DI[405] OFF: reset timer (flicker protection) ;
 183:  ! DI[405] ON: check settle timer ;
 184:  IF R[164:St2LoadStep]<>1,JMP LBL[26] ;
 185:  IF DI[469:X4.5 St2 Vacuum Reached]=ON,JMP LBL[27] ;
 186:  TIMER[3]=RESET ;
 187:  TIMER[3]=START ;
 188:  JMP LBL[29] ;
 189:  LBL[27] ;
 190:  R[122:PistElapsed]=TIMER[3] ;
 191:  IF R[122:PistElapsed]<R[168:VacSettleTime],JMP LBL[29] ;
 192:  ! Settle passed: station confirmed ;
 193:  TIMER[3]=STOP ;
 194:  R[155:St2Status]=1 ;
 195:  R[164:St2LoadStep]=2 ;
 196:  JMP LBL[29] ;
 197:  LBL[26] ;
 198:   ;
 199:  ! --- Step 2: confirmed, monitor DI[405] --- ;
 200:  IF R[164:St2LoadStep]<>2,JMP LBL[29] ;
 201:  IF DI[469:X4.5 St2 Vacuum Reached]=ON,JMP LBL[29] ;
 202:  ! DI[405] lost: start vacuum break ;
 203:  DO[470:X4.6 St2 Vacuum ACT]=OFF ;
 204:  ! DO[471:X4.7 St2 AirPush ACT]=ON ;
 205:  TIMER[3]=RESET ;
 206:  TIMER[3]=START ;
 207:  R[155:St2Status]=0 ;
 208:  R[164:St2LoadStep]=3 ;
 209:  LBL[29] ;
 210:   ;
 211:   ;
 212:  ! ============================= ;
 213:  ! READY EVALUATION ;
 214:  ! Runs every scan. ;
 215:  ! R[151:Ready]=1 only when ALL conditions met. ;
 216:  ! SR[10] updated with reason when not ready. ;
 217:  ! ============================= ;
 218:   ;
 219:  ! Check tray ;
 220:  IF DI[592:X8.0 PBS tray in]=ON,JMP LBL[40] ;
 221:  R[151:Ready]=0 ;
 222:  CALL SET_STR('No tray',10) ;
 223:  JMP LBL[99] ;
 224:  LBL[40] ;
 225:   ;
 226:  IF R[153:TrayFull]=1,JMP LBL[41] ;
 227:  R[151:Ready]=0 ;
 228:  CALL SET_STR('Tray empty',10) ;
 229:  JMP LBL[99] ;
 230:  LBL[41] ;
 231:   ;
 232:  ! Check at least one station OK ;
 233:  IF R[154:St1Status]=1,JMP LBL[42] ;
 234:  IF R[155:St2Status]=1,JMP LBL[42] ;
 235:  R[151:Ready]=0 ;
 236:  CALL SET_STR('No OB loaded',10) ;
 237:  JMP LBL[99] ;
 238:  LBL[42] ;
 239:   ;
 240:  ! Check no active error ;
 241:  IF R[10:Error Code]=0,JMP LBL[43] ;
 242:  R[151:Ready]=0 ;
 243:  CALL SET_STR('Error present',10) ;
 244:  JMP LBL[99] ;
 245:  LBL[43] ;
 246:   ;
 247:  ! All conditions met ;
 248:  R[151:Ready]=1 ;
 249:  CALL SET_STR('Ready',10) ;
 250:   ;
 251:  LBL[99] ;
/POS
/END
