/PROG  MAIN
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Main loop";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-16  TIME 12:00:00;
MODIFIED	= DATE 26-07-05  TIME 14:45:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  ! === MAIN === ;
   2:  ! State machine master controller. ;
   3:  ! R[1:MODE_ACT]  = current state ;
   4:  ! R[2:MODE_CMD]  = operator command ;
   5:  ! R[10:Error Code] = shared fault code ;
   6:  ! ;
   7:  ! States: ;
   8:  !  0=IDLE   1=INIT   2=STANDBY ;
   9:  !  4=RUN    5=PAUSE  6=DONE ;
  10:  !  7=CALIB  8=ERROR ;
  11:  ! ;
  12:  ! MODE_CMD values: ;
  13:  !  1=INIT  2=STANDBY  4=RUN ;
  14:  !  5=PAUSE  7=CALIB ;
  15:   ;
  16:  ! --- One-time startup (before loop) --- ;
  17:  CALL STARTUP ;
  18:  R[1:MODE_ACT]=0 ;
  19:   ;
  20:  ! --- Main loop --- ;
  21:  LBL[1] ;
  22:   ;
  23:  ! Always: run safety monitor ;
  24:  CALL MONITOR ;
  25:   ;
  26:  ! Error gate: any fault -> ERROR state ;
  27:  ! (skip if already in ERROR to avoid loop) ;
  28:  IF R[10:Error Code]=0,JMP LBL[2] ;
  29:  IF R[1:MODE_ACT]=8,JMP LBL[2] ;
  30:  JMP LBL[80] ;
  31:  LBL[2] ;
  32:   ;
  33:  ! State dispatch ;
  34:  SELECT R[1:MODE_ACT]=0,JMP LBL[10] ;
  35:         =1,JMP LBL[20] ;
  36:         =2,JMP LBL[30] ;
  37:         =4,JMP LBL[40] ;
  38:         =5,JMP LBL[45] ;
  39:         =6,JMP LBL[50] ;
  40:         =7,JMP LBL[60] ;
  41:         =8,JMP LBL[70] ;
  42:         ELSE,JMP LBL[10] ;
  43:   ;
  44:   ;
  45:  ! ============================= ;
  46:  ! State 0: IDLE ;
  47:  ! Boot state. No motion. ;
  48:  ! CMD=1 -> INIT. ;
  49:  ! ============================= ;
  50:  LBL[10] ;
  51:  IF R[2:MODE_CMD]=1,JMP LBL[90] ;
  52:  JMP LBL[99] ;
  53:   ;
  54:   ;
  55:  ! ============================= ;
  56:  ! State 1: INIT ;
  57:  ! Step-per-scan sub-program. ;
  58:  ! ok -> STANDBY   fault -> ERROR ;
  59:  ! ============================= ;
  60:  LBL[20] ;
  61:  CALL INIT ;
  62:  IF R[90:InitStatus]=0,JMP LBL[80] ;
  63:  IF R[90:InitStatus]<>1,JMP LBL[99] ;
  64:  ! INIT ok -> STANDBY ;
  65:  R[1:MODE_ACT]=2 ;
  66:  JMP LBL[1] ;
  67:   ;
  68:   ;
  69:  ! ============================= ;
  70:  ! State 2: STANDBY ;
  71:  ! Operator loads parts. ;
  72:  ! CMD=1 -> re-INIT ;
  73:  ! CMD=7 -> CALIB ;
  74:  ! CMD=4 + R[151]=1 -> RUN ;
  75:  ! CMD=4 + R[151]=0 -> message, ignore ;
  76:  ! ============================= ;
  77:  LBL[30] ;
  78:   ;
  79:  ! CMD=1: re-run INIT ;
  80:  IF R[2:MODE_CMD]=1,JMP LBL[90] ;
  81:   ;
  82:  ! CMD=7: go to CALIB ;
  83:  IF R[2:MODE_CMD]=7,JMP LBL[95] ;
  84:   ;
  85:  ! CMD=4: check ready condition ;
  86:  IF R[2:MODE_CMD]<>4,JMP LBL[31] ;
  87:  IF R[151:Ready]=1,JMP LBL[32] ;
  88:  ! CMD=4 but not ready - message and clear ;
  89:  CALL SET_STR('Not ready for RUN',10) ;
  90:  R[2:MODE_CMD]=0 ;
  91:  JMP LBL[31] ;
  92:  LBL[32] ;
  93:  ! Ready and CMD=4 -> RUN ;
  94:  R[2:MODE_CMD]=0 ;
  95:  R[7:RUN_STEP]=0 ;
  96:  R[1:MODE_ACT]=4 ;
  97:  JMP LBL[1] ;
  98:  LBL[31] ;
  99:   ;
 100:  CALL STANDBY ;
 101:  JMP LBL[99] ;
 102:   ;
 103:   ;
 104:  ! ============================= ;
 105:  ! State 4: RUN ;
 106:  ! CMD=5 -> PAUSE ;
 107:  ! ok -> DONE   fault -> ERROR ;
 108:  ! ============================= ;
 109:  LBL[40] ;
 110:   ;
 111:  ! CMD=5: pause cycle ;
 112:  IF R[2:MODE_CMD]<>5,JMP LBL[41] ;
 113:  R[2:MODE_CMD]=0 ;
 114:  R[1:MODE_ACT]=5 ;
 115:  JMP LBL[1] ;
 116:  LBL[41] ;
 117:   ;
 118:  CALL RUN ;
 119:  IF R[20:RunStatus]=0,JMP LBL[80] ;
 120:  IF R[20:RunStatus]<>1,JMP LBL[99] ;
 121:  ! RUN complete -> DONE ;
 122:  R[1:MODE_ACT]=6 ;
 123:  JMP LBL[1] ;
 124:   ;
 125:   ;
 126:  ! ============================= ;
 127:  ! State 5: PAUSE ;
 128:  ! CMD=4 -> resume RUN ;
 129:  ! CMD=2 -> abort to STANDBY ;
 130:  ! ============================= ;
 131:  LBL[45] ;
 132:  IF R[2:MODE_CMD]=4,JMP LBL[46] ;
 133:  IF R[2:MODE_CMD]=2,JMP LBL[47] ;
 134:  JMP LBL[99] ;
 135:  LBL[46] ;
 136:  ! Resume RUN ;
 137:  R[2:MODE_CMD]=0 ;
 138:  R[1:MODE_ACT]=4 ;
 139:  JMP LBL[1] ;
 140:  LBL[47] ;
 141:  ! Abort -> STANDBY ;
 142:  R[2:MODE_CMD]=0 ;
 143:  R[151:Ready]=0 ;
 144:  R[1:MODE_ACT]=2 ;
 145:  JMP LBL[1] ;
 146:   ;
 147:   ;
 148:  ! ============================= ;
 149:  ! State 6: DONE ;
 150:  ! Operator must unload parts first. ;
 151:  ! Only CMD=2 accepted -> STANDBY. ;
 152:  ! ============================= ;
 153:  LBL[50] ;
 154:  IF R[2:MODE_CMD]<>2,JMP LBL[99] ;
 155:  R[2:MODE_CMD]=0 ;
 156:  R[151:Ready]=0 ;
 157:  R[1:MODE_ACT]=2 ;
 158:  JMP LBL[1] ;
 159:   ;
 160:   ;
 161:  ! ============================= ;
 162:  ! State 7: CALIB ;
 163:  ! Step-per-scan sub-program. ;
 164:  ! ok -> STANDBY   fault -> ERROR ;
 165:  ! ============================= ;
 166:  LBL[60] ;
 167:  CALL CALIB_NEEDLE ;
 168:  IF R[100:CalibStatus]=0,JMP LBL[80] ;
 169:  IF R[100:CalibStatus]<>1,JMP LBL[99] ;
 170:  ! CALIB ok -> STANDBY ;
 171:  R[117:CalibStep]=0 ;
 172:  R[1:MODE_ACT]=2 ;
 173:  JMP LBL[1] ;
 174:   ;
 175:   ;
 176:  ! ============================= ;
 177:  ! State 8: ERROR ;
 178:  ! No ERROR sub yet - reset via CMD below. ;
 179:  ! CMD=1 -> clear + re-INIT ;
 180:  ! CMD=2 -> clear + STANDBY ;
 181:  ! ============================= ;
 182:  LBL[70] ;
 183:  ! CALL ERROR_HANDLER ;   no ERROR sub yet ;
 184:   ;
 185:  IF R[2:MODE_CMD]=1,JMP LBL[71] ;
 186:  IF R[2:MODE_CMD]=2,JMP LBL[72] ;
 187:  JMP LBL[99] ;
 188:  LBL[71] ;
 189:  ! Ack + re-INIT ;
 190:  R[10:Error Code]=0 ;
 191:  JMP LBL[90] ;
 192:  LBL[72] ;
 193:  ! Ack + STANDBY ;
 194:  R[10:Error Code]=0 ;
 195:  R[1:MODE_ACT]=2 ;
 196:  JMP LBL[1] ;
 197:   ;
 198:   ;
 199:  ! ============================= ;
 200:  ! Error gate: set ERROR state ;
 201:  ! ============================= ;
 202:  LBL[80] ;
 203:  R[1:MODE_ACT]=8 ;
 204:  JMP LBL[1] ;
 205:   ;
 206:   ;
 207:  ! ============================= ;
 208:  ! INIT transition: ;
 209:  ! Zero sub status/step regs, ;
 210:  ! clear command, set state=INIT ;
 211:  ! ============================= ;
 212:  LBL[90] ;
 213:  R[90:InitStatus]=0 ;
 214:  R[100:CalibStatus]=0 ;
 215:  ! RUN + CLOSE_OB status/step ;
 216:  R[7:RUN_STEP]=0 ;
 217:  R[20:RunStatus]=0 ;
 218:  R[21:CurStation]=0 ;
 219:  R[22:CloseStatus]=0 ;
 220:  R[23:CloseStep]=0 ;
 221:  R[2:MODE_CMD]=0 ;
 222:  R[1:MODE_ACT]=1 ;
 223:  JMP LBL[1] ;
 224:   ;
 225:   ;
 226:  ! ============================= ;
 227:  ! CALIB transition: ;
 228:  ! Reset calib registers, set state=CALIB ;
 229:  ! ============================= ;
 230:  LBL[95] ;
 231:  R[100:CalibStatus]=0 ;
 232:  R[117:CalibStep]=0 ;
 233:  R[120:MeasStep]=0 ;
 234:  R[2:MODE_CMD]=0 ;
 235:  R[1:MODE_ACT]=7 ;
 236:  JMP LBL[1] ;
 237:   ;
 238:  LBL[99] ;
 239:  JMP LBL[1] ;
/POS
/END
