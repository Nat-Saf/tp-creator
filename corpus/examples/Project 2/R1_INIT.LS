/PROG R1_INIT
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "INIT V3: recover, nest to P2";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-16  TIME 00:00:00;
MODIFIED	= DATE 26-07-16  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- INIT: verify and recover home state (V3) ---    ;
   2:  !  DI[33]=ON (DCS Zone) = robot in nest - cannot auto-move.    ;
   3:  !  If clear: rotate to 0, pistons+linear safe retract, axis to P2.    ;
   4:  !  V3 recovery target: nest UNLOCKED, 0 deg, at P2 (operator),    ;
   5:  !  robot at HOME, end-effector outputs OFF. DO[21]=done pulse;    ;
   6:  !  DO[22]=ON during any fault PAUSE (operator needed, resume retries).    ;
   7:  !  Audit 2026-07-27: ORANGE while recovering, GREEN only on success;    ;
   8:  !  all faults retry-on-resume; DI[533] stale-part gate + end-effector    ;
   9:  !  normalization added. 29/07 I/O map + locker sequencing.    ;
  10:  CALL R1_TOWER(3,0)    ;
  11:  DO[21]=OFF    ;
  12:  DO[22]=OFF    ;
  13:  !  1: robot inside nest zone? (DCS Zone output via DI[33])    ;
  14:  LBL[10]    ;
  15:  IF DI[33]=OFF, JMP LBL[1]    ;
  16:  CALL SET_STR('INIT:ROBOT IN NEST ZONE',1)    ;
  17:  DO[22]=ON    ;
  18:  CALL R1_TOWER(1,3)    ;
  19:  PAUSE    ;
  20:  DO[22]=OFF    ;
  21:  CALL R1_TOWER(3,0)    ;
  22:  JMP LBL[10]    ;
  23:  LBL[1]    ;
  24:  !  1b: stale part on tool? Operator removes it, resume re-checks.    ;
  25:  !  Actuate output stays untouched until confirmed empty    ;
  26:  !  (releasing with a part held would drop it).    ;
  27:  LBL[11]    ;
  28:  IF DI[533]=OFF, JMP LBL[12]    ;
  29:  CALL SET_STR('INIT:PART IN GRIPPER',1)    ;
  30:  DO[22]=ON    ;
  31:  CALL R1_TOWER(1,3)    ;
  32:  PAUSE    ;
  33:  DO[22]=OFF    ;
  34:  CALL R1_TOWER(3,0)    ;
  35:  JMP LBL[11]    ;
  36:  LBL[12]    ;
  37:  !  1c: normalize end-effector outputs (gripper empty confirmed)    ;
  38:  !  DO[536]=shared actuate OFF=release, DO[535]=compensator rigid    ;
  39:  DO[536]=OFF    ;
  40:  DO[535]=OFF    ;
  41:  !  2: fix rotate piston if not at 0 deg (DI[435]); locker enabled    ;
  42:  !  for the recovery rotation, re-locked after (fail-locked policy)    ;
  43:  LBL[13]    ;
  44:  IF DI[435]=ON, JMP LBL[2]    ;
  45:  DO[562]=OFF    ;
  46:  DO[561]=ON    ;
  47:  DO[469]=OFF    ;
  48:  DO[470]=ON    ;
  49:  R[90]=0    ;
  50:  LBL[30]    ;
  51:  IF DI[435]=ON, JMP LBL[2]    ;
  52:  WAIT .1(sec)    ;
  53:  R[90]=R[90]+1    ;
  54:  IF R[90]<200, JMP LBL[30]    ;
  55:  !  de-command + re-lock before fault (restart interlock)    ;
  56:  DO[470]=OFF    ;
  57:  DO[561]=OFF    ;
  58:  DO[562]=ON    ;
  59:  CALL SET_STR('INIT:ROTATE TIMEOUT',1)    ;
  60:  DO[22]=ON    ;
  61:  CALL R1_TOWER(1,3)    ;
  62:  PAUSE    ;
  63:  DO[22]=OFF    ;
  64:  CALL R1_TOWER(3,0)    ;
  65:  JMP LBL[13]    ;
  66:  LBL[2]    ;
  67:  DO[470]=OFF    ;
  68:  DO[561]=OFF    ;
  69:  DO[562]=ON    ;
  70:  !  3: pistons + linear retract in safe order (rotate@0 verified inside)    ;
  71:  CALL R1_SAFE_RETRACT_LIN    ;
  72:  DO[468]=OFF    ;
  73:  !  4: axis to P2 (operator station) if not there (DI[500]) - V3    ;
  74:  LBL[14]    ;
  75:  IF DI[500]=ON, JMP LBL[3]    ;
  76:  DO[562]=OFF    ;
  77:  DO[561]=ON    ;
  78:  DO[497]=OFF    ;
  79:  DO[498]=ON    ;
  80:  R[90]=0    ;
  81:  LBL[31]    ;
  82:  IF DI[500]=ON, JMP LBL[3]    ;
  83:  WAIT .1(sec)    ;
  84:  R[90]=R[90]+1    ;
  85:  IF R[90]<100, JMP LBL[31]    ;
  86:  DO[498]=OFF    ;
  87:  DO[561]=OFF    ;
  88:  DO[562]=ON    ;
  89:  CALL SET_STR('INIT:AXIS P2 TIMEOUT',1)    ;
  90:  DO[22]=ON    ;
  91:  CALL R1_TOWER(1,3)    ;
  92:  PAUSE    ;
  93:  DO[22]=OFF    ;
  94:  CALL R1_TOWER(3,0)    ;
  95:  JMP LBL[14]    ;
  96:  LBL[3]    ;
  97:  DO[498]=OFF    ;
  98:  DO[561]=OFF    ;
  99:  DO[562]=ON    ;
 100:  !  5: return robot to HOME    ;
 101:  J PR[1] 50% FINE    ;
 102:  !  Init complete - signal PC    ;
 103:  CALL SET_STR('INIT OK',2)    ;
 104:  CALL R1_TOWER(2,0)    ;
 105:  DO[21]=ON    ;
 106:  WAIT .5(sec)    ;
 107:  DO[21]=OFF    ;
/END
