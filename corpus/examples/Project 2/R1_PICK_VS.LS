/PROG R1_PICK_VS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Pick VS. R[4]=slot(1-10) R[5]=tray(1=V1 2=V2)";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-01  TIME 00:00:00;
MODIFIED	= DATE 26-06-21  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- PICK V-SCANNER --- ;
   2:  !  Audit 2026-07-27: stale-part gate BEFORE opening the gripper (a ;
   3:  !  held component would be silently dropped at the entry pose); all ;
   4:  !  gripper faults retry-on-resume with SR[1] reason. ;
   5:  LBL[14]    ;
   6:  IF DI[533]=OFF, JMP LBL[15]    ;
   7:  CALL SET_STR('VS PART HELD AT ENTRY',1)    ;
   8:  CALL R1_TOWER(1,3)    ;
   9:  PAUSE    ;
  10:  CALL R1_TOWER(3,0)    ;
  11:  JMP LBL[14]    ;
  12:  LBL[15]    ;
  13:  LBL[12]    ;
  14:  !  Shared actuate (29/07 map): DO[536] ON=grip/hold, OFF=release. ;
  15:  DO[536]=OFF    ;
  16:  !  Wait gripper released/open (timeout); resume re-commands (LBL[12]) ;
  17:  R[90]=0    ;
  18:  LBL[10]    ;
  19:  IF DI[533]=OFF, JMP LBL[11]    ;
  20:  WAIT .1(sec)    ;
  21:  R[90]=R[90]+1    ;
  22:  IF R[90]<50, JMP LBL[10]    ;
  23:  CALL SET_STR('VS GRIP OPEN TIMEOUT',1)    ;
  24:  CALL R1_TOWER(1,3)    ;
  25:  PAUSE    ;
  26:  CALL R1_TOWER(3,0)    ;
  27:  JMP LBL[12]    ;
  28:  LBL[11]    ;
  29:  DO[535]=ON    ;
  30:   ;
  31:  !  Select base tray position (slot 1, col 1) ;
  32:  IF R[5]=2, JMP LBL[1]    ;
  33:  PR[20]=PR[10]    ;
  34:  JMP LBL[2]    ;
  35:  LBL[1]    ;
  36:  PR[20]=PR[11]    ;
  37:  LBL[2]    ;
  38:   ;
  39:  !  Decode slot R[4] (1-10): row R[31], col R[30] ;
  40:  !  TP division does NOT floor - derive row by range ;
  41:  R[31]=0    ;
  42:  IF R[4]<3, JMP LBL[5]    ;
  43:  R[31]=1    ;
  44:  IF R[4]<5, JMP LBL[5]    ;
  45:  R[31]=2    ;
  46:  IF R[4]<7, JMP LBL[5]    ;
  47:  R[31]=3    ;
  48:  IF R[4]<9, JMP LBL[5]    ;
  49:  R[31]=4    ;
  50:  LBL[5]    ;
  51:  !  col = (R[4]-1) - 2*row  (exact integer) ;
  52:  R[30]=R[4]-1    ;
  53:  R[32]=R[31]*2    ;
  54:  R[30]=R[30]-R[32]    ;
  55:   ;
  56:  !  Apply X offset: col * delta_X_VS ;
  57:  R[32]=PR[20,1]    ;
  58:  R[33]=R[30]*R[10]    ;
  59:  R[32]=R[32]+R[33]    ;
  60:  PR[20,1]=R[32]    ;
  61:   ;
  62:  !  Apply Y offset: row * delta_Y_VS ;
  63:  R[32]=PR[20,2]    ;
  64:  R[33]=R[31]*R[12]    ;
  65:  R[32]=R[32]+R[33]    ;
  66:  PR[20,2]=R[32]    ;
  67:   ;
  68:  !  Build approach: PR[21] = PR[20] with Z+80 ;
  69:  PR[21]=PR[20]    ;
  70:  R[32]=PR[20,3]    ;
  71:  R[32]=R[32]+80    ;
  72:  PR[21,3]=R[32]    ;
  73:   ;
  74:  !  Move and pick ;
  75:  J PR[21] 80% CNT50    ;
  76:  L PR[20] 150mm/sec FINE    ;
  77:   ;
  78:  !  Grip: DO[536]=ON closes on the part (timeout); resume re-grips (LBL[13]) ;
  79:  LBL[13]    ;
  80:  DO[536]=ON    ;
  81:  R[90]=0    ;
  82:  LBL[3]    ;
  83:  IF DI[533]=ON, JMP LBL[4]    ;
  84:  WAIT .1(sec)    ;
  85:  R[90]=R[90]+1    ;
  86:  IF R[90]<50, JMP LBL[3]    ;
  87:  CALL SET_STR('VS GRIP CLOSE TIMEOUT',1)    ;
  88:  CALL R1_TOWER(1,3)    ;
  89:  PAUSE    ;
  90:  CALL R1_TOWER(3,0)    ;
  91:  JMP LBL[13]    ;
  92:  LBL[4]    ;
  93:   ;
  94:  !  Retract ;
  95:  L PR[21] 200mm/sec FINE    ;
/END
