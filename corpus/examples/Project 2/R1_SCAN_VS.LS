/PROG R1_SCAN_VS
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "IV3 direct scan VS trays -> R4";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-16  TIME 00:00:00;
MODIFIED	= DATE 26-07-16  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- SCAN VS TRAYS - IV3 DIRECT (2026-08-02, no PC) ---    ;
   2:  ! Replaces PC code (R[50] tray image). Flow: select IV3 program,    ;
   3:  ! move over the selected tray, trigger, read the slot bits, pick    ;
   4:  ! the FIRST occupied slot -> R[4] (guaranteed 1-10 on return).    ;
   5:  ! Empty or no tray (position-adjust NG) -> toggle R[5] and try    ;
   6:  ! the other tray; BOTH bad -> operator PAUSE ('check/reload'),    ;
   7:  ! resume rescans. Selector ends on the tray that answered.    ;
   8:  ! DI[625-634] = slots 1-10 (ON = occupied, ROW-MAJOR = tool 01-10)    ;
   9:  ! DI[635] = TRAY_DETECT (position-adjust OK)   DI[637] = BUSY    ;
  10:  ! DI[636] = general result - NOT consumed (slot bits suffice)    ;
  11:  ! DO[625] = TRIGGER   >>> ADDRESSES ASSUMED - bench remap item.    ;
  12:  ! R[34] = trays tried this scan. R[99]=1 (sim): return slot 1.    ;
  13:  IF R[99]=0, JMP LBL[1]    ;
  14:  R[4]=1    ;
  15:  JMP LBL[99]    ;
  16:  LBL[1]    ;
  17:  CALL R1_IV3_PROG(4)    ;
  18:  R[34]=0    ;
  19:  !  position over the selected tray (1=V1 PR[71], 2=V2 PR[73])    ;
  20:  LBL[10]    ;
  21:  IF R[5]=2, JMP LBL[2]    ;
  22:  J PR[71] 80% FINE    ;
  23:  JMP LBL[3]    ;
  24:  LBL[2]    ;
  25:  J PR[73] 80% FINE    ;
  26:  LBL[3]    ;
  27:  !  trigger; tolerate a missed BUSY rise (fast eval): pulse, settle,    ;
  28:  !  then wait BUSY low = results valid. >>> BENCH: timing vs real IV3    ;
  29:  LBL[11]    ;
  30:  DO[625]=ON    ;
  31:  WAIT .2(sec)    ;
  32:  DO[625]=OFF    ;
  33:  WAIT .3(sec)    ;
  34:  R[90]=0    ;
  35:  LBL[12]    ;
  36:  IF DI[637]=OFF, JMP LBL[13]    ;
  37:  WAIT .1(sec)    ;
  38:  R[90]=R[90]+1    ;
  39:  IF R[90]<50, JMP LBL[12]    ;
  40:  !  BUSY stuck 5 s - camera hung/disconnected; resume re-triggers    ;
  41:  CALL SET_STR('IV3:BUSY STUCK',1)    ;
  42:  CALL R1_TOWER(1,3)    ;
  43:  PAUSE    ;
  44:  CALL R1_TOWER(3,0)    ;
  45:  JMP LBL[11]    ;
  46:  LBL[13]    ;
  47:  !  tray present? (position-adjust tool) - NG covers missing AND    ;
  48:  !  badly seated/unreadable tray: either way try the other one    ;
  49:  IF DI[635]=OFF, JMP LBL[40]    ;
  50:  !  first occupied slot wins (ON = scanner present)    ;
  51:  R[4]=0    ;
  52:  IF DI[625]=OFF, JMP LBL[21]    ;
  53:  R[4]=1    ;
  54:  JMP LBL[50]    ;
  55:  LBL[21]    ;
  56:  IF DI[626]=OFF, JMP LBL[22]    ;
  57:  R[4]=2    ;
  58:  JMP LBL[50]    ;
  59:  LBL[22]    ;
  60:  IF DI[627]=OFF, JMP LBL[23]    ;
  61:  R[4]=3    ;
  62:  JMP LBL[50]    ;
  63:  LBL[23]    ;
  64:  IF DI[628]=OFF, JMP LBL[24]    ;
  65:  R[4]=4    ;
  66:  JMP LBL[50]    ;
  67:  LBL[24]    ;
  68:  IF DI[629]=OFF, JMP LBL[25]    ;
  69:  R[4]=5    ;
  70:  JMP LBL[50]    ;
  71:  LBL[25]    ;
  72:  IF DI[630]=OFF, JMP LBL[26]    ;
  73:  R[4]=6    ;
  74:  JMP LBL[50]    ;
  75:  LBL[26]    ;
  76:  IF DI[631]=OFF, JMP LBL[27]    ;
  77:  R[4]=7    ;
  78:  JMP LBL[50]    ;
  79:  LBL[27]    ;
  80:  IF DI[632]=OFF, JMP LBL[28]    ;
  81:  R[4]=8    ;
  82:  JMP LBL[50]    ;
  83:  LBL[28]    ;
  84:  IF DI[633]=OFF, JMP LBL[29]    ;
  85:  R[4]=9    ;
  86:  JMP LBL[50]    ;
  87:  LBL[29]    ;
  88:  IF DI[634]=OFF, JMP LBL[40]    ;
  89:  R[4]=10    ;
  90:  LBL[50]    ;
  91:  JMP LBL[99]    ;
  92:  !  tray empty / not detected: toggle selector, try the other tray    ;
  93:  LBL[40]    ;
  94:  R[34]=R[34]+1    ;
  95:  IF R[5]=1, JMP LBL[41]    ;
  96:  R[5]=1    ;
  97:  JMP LBL[42]    ;
  98:  LBL[41]    ;
  99:  R[5]=2    ;
 100:  LBL[42]    ;
 101:  IF R[34]<2, JMP LBL[10]    ;
 102:  !  both trays empty/undetected - operator reloads, resume rescans    ;
 103:  R[34]=0    ;
 104:  CALL SET_STR('CHECK/RELOAD VS TRAYS',1)    ;
 105:  CALL R1_TOWER(1,3)    ;
 106:  PAUSE    ;
 107:  CALL R1_TOWER(3,0)    ;
 108:  JMP LBL[10]    ;
 109:  LBL[99]    ;
/END
