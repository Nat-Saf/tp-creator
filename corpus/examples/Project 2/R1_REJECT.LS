/PROG R1_REJECT
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Drop held component in reject bin PR[80]. R[21] selects release.";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-21  TIME 00:00:00;
MODIFIED	= DATE 26-06-21  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- REJECT TO BIN (#14) --- ;
   2:  !  Robot is holding a component that must be rejected. ;
   3:  !  Safety check first: nest hardware must be DISENGAGED and the ;
   4:  !  robot outside the nest zone before driving. ;
   5:  !  If safe: nest-clear via R1_SCAN_NEST (IV3 direct 2026-08-02), ;
   6:  !  then reject bin PR[80], release component. ;
   7:  !  Release = shared actuate DO[536]=OFF (both tool types), DI[533] confirm. ;
   8:  !  Audit 2026-07-27: (a) abort-to-caller path REMOVED - every fault ;
   9:  !  is retry-on-resume, the program never returns still holding the ;
  10:  !  part; (b) safety block uses POSITIVE disengaged sensors (DI[433], ;
  11:  !  DI[402/404/406/408]) - absence of 'engaged' is not 'disengaged'; ;
  12:  !  (c) polygon release is DI[533]-confirmed like the VS branch. ;
  13:   ;
  14:  !--- SAFETY BLOCK: nest/robot state must be safe to drive --- ;
  15:  LBL[20]    ;
  16:  IF DI[33]=OFF, JMP LBL[5]    ;
  17:  CALL SET_STR('REJECT:UNSAFE-IN NEST ZONE',1)    ;
  18:  CALL R1_TOWER(1,3)    ;
  19:  PAUSE    ;
  20:  CALL R1_TOWER(3,0)    ;
  21:  JMP LBL[20]    ;
  22:  LBL[5]    ;
  23:   ;
  24:  ! Linear piston retracted - positive sensor DI[433] ;
  25:  LBL[21]    ;
  26:  IF DI[433]=ON, JMP LBL[6]    ;
  27:  CALL SET_STR('REJECT:LINEAR NOT RETRACT',1)    ;
  28:  CALL R1_TOWER(1,3)    ;
  29:  PAUSE    ;
  30:  CALL R1_TOWER(3,0)    ;
  31:  JMP LBL[21]    ;
  32:  LBL[6]    ;
  33:   ;
  34:  ! All 4 holding pistons RELEASED - positive sensors ;
  35:  LBL[22]    ;
  36:  IF DI[402]=ON, JMP LBL[7]    ;
  37:  CALL SET_STR('REJECT:PISTON 1 NOT REL',1)    ;
  38:  CALL R1_TOWER(1,3)    ;
  39:  PAUSE    ;
  40:  CALL R1_TOWER(3,0)    ;
  41:  JMP LBL[22]    ;
  42:  LBL[7]    ;
  43:  LBL[23]    ;
  44:  IF DI[404]=ON, JMP LBL[8]    ;
  45:  CALL SET_STR('REJECT:PISTON 2 NOT REL',1)    ;
  46:  CALL R1_TOWER(1,3)    ;
  47:  PAUSE    ;
  48:  CALL R1_TOWER(3,0)    ;
  49:  JMP LBL[23]    ;
  50:  LBL[8]    ;
  51:  LBL[24]    ;
  52:  IF DI[406]=ON, JMP LBL[9]    ;
  53:  CALL SET_STR('REJECT:PISTON 3 NOT REL',1)    ;
  54:  CALL R1_TOWER(1,3)    ;
  55:  PAUSE    ;
  56:  CALL R1_TOWER(3,0)    ;
  57:  JMP LBL[24]    ;
  58:  LBL[9]    ;
  59:  LBL[25]    ;
  60:  IF DI[408]=ON, JMP LBL[10]    ;
  61:  CALL SET_STR('REJECT:PISTON 4 NOT REL',1)    ;
  62:  CALL R1_TOWER(1,3)    ;
  63:  PAUSE    ;
  64:  CALL R1_TOWER(3,0)    ;
  65:  JMP LBL[25]    ;
  66:  LBL[10]    ;
  67:   ;
  68:  !--- SAFETY PASSED: proceed with reject --- ;
  69:  !  Nest must be CLEAR before the bin run - IV3 DIRECT (2026-08-02, ;
  70:  !  was PC code 8): R1_SCAN_NEST owns the PR[42] move + image + ;
  71:  !  occupied PAUSE and returns only when the nest is clear. ;
  72:  CALL R1_SCAN_NEST    ;
  73:   ;
  74:  !  Move to reject bin drop position ;
  75:  J PR[80] 80% FINE    ;
  76:   ;
  77:  !  Release (shared actuate, 29/07 map): DO[536]=OFF releases BOTH ;
  78:  !  tool types (VS jaws open / vacuum off); DI[533]=OFF confirms. ;
  79:  LBL[29]    ;
  80:  DO[536]=OFF    ;
  81:  R[90]=0    ;
  82:  LBL[11]    ;
  83:  IF DI[533]=OFF, JMP LBL[3]    ;
  84:  WAIT .1(sec)    ;
  85:  R[90]=R[90]+1    ;
  86:  IF R[90]<50, JMP LBL[11]    ;
  87:  !  Part still held - operator removes it, resume re-checks (LBL[29]) ;
  88:  CALL SET_STR('REJECT:PART STILL HELD',1)    ;
  89:  CALL R1_TOWER(1,3)    ;
  90:  PAUSE    ;
  91:  CALL R1_TOWER(3,0)    ;
  92:  JMP LBL[29]    ;
  93:  LBL[3]    ;
  94:   ;
  95:  !  Component released - normalize outputs, go home ;
  96:  DO[536]=OFF    ;
  97:  DO[535]=OFF    ;
  98:  J PR[1] 80% FINE    ;
/END
