/PROG R1_TOOL_CHG
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "Tool chg R20:1=VS 2=LR 3=SR";
PROG_SIZE	= 0;
CREATE		= DATE 26-06-01  TIME 00:00:00;
MODIFIED	= DATE 26-06-08  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- TOOL CHANGE - SCHUNK CPS 007-K-A15 (single coil) --- ;
   2:  !  R[20]=target tool (1=VS 2=LR/Corner-Poly 3=SR-Poly) - 29/07 map ;
   3:  !  R[21]=current tool on robot (tool-ID bits via R1_CHECK_TOOL) ;
   4:  !  DO[532]=ON releases (air-unlock). DO[532]=OFF spring-locks ;
   5:  !  Sensing (IO map 29/07): 'bearings out' sensor DROPPED. Engagement ;
   6:  !  proof = tool-ID bits DI[529]/DI[530] (VGA pins mate on coupling) ;
   7:  !  cross-checked with DI[531]=OFF (bearings not retracted). ;
   8:  !  >>> BENCH: verify DO[532] polarity + that VGA pins mate no earlier ;
   9:  !  >>> than bearing lock (else ID can read before mechanical lock). ;
  10:  !  Audit 2026-07-27: every fault is retry-on-resume; DO[532] is NEVER ;
  11:  !  energized with an unresolved tool identity; R[21] comes from ;
  12:  !  hardware (R1_CHECK_TOOL) after the swap, not from software. ;
  13:   ;
  14:  !--- STEP 0: NO PART ON TOOL (DI[533]) --- ;
  15:  !  A held component would be crushed into the dock or dropped when ;
  16:  !  the coupler air-unlocks. Operator removes it, resume re-checks. ;
  17:  LBL[50]    ;
  18:  IF DI[533]=OFF, JMP LBL[51]    ;
  19:  CALL SET_STR('TOOLCHG:PART ON TOOL',1)    ;
  20:  CALL R1_TOWER(1,3)    ;
  21:  PAUSE    ;
  22:  CALL R1_TOWER(3,0)    ;
  23:  JMP LBL[50]    ;
  24:  LBL[51]    ;
  25:   ;
  26:  !--- STEP 1: RETURN CURRENT TOOL IF ONE IS MOUNTED --- ;
  27:  !  Presence = tool-ID bits (00 = no tool mated). Fresh hardware read ;
  28:  !  makes this self-sufficient regardless of caller state. ;
  29:  CALL R1_CHECK_TOOL    ;
  30:  IF R[21]=0, JMP LBL[6]    ;
  31:  J PR[2] 100% FINE    ;
  32:  !  Dispatch by R[21] (decode is total: bits give 0-3, 0 already left) ;
  33:  IF R[21]=1, JMP LBL[2]    ;
  34:  IF R[21]=2, JMP LBL[3]    ;
  35:  JMP LBL[4]    ;
  36:  LBL[2]    ;
  37:  L PR[3] 200mm/sec FINE    ;
  38:  JMP LBL[5]    ;
  39:  LBL[3]    ;
  40:  L PR[4] 200mm/sec FINE    ;
  41:  JMP LBL[5]    ;
  42:  LBL[4]    ;
  43:  L PR[5] 200mm/sec FINE    ;
  44:  LBL[5]    ;
  45:  !  Release tool into dock (DO[532]=ON), wait unlocked (timeout) ;
  46:  LBL[41]    ;
  47:  DO[532]=ON    ;
  48:  R[90]=0    ;
  49:  LBL[7]    ;
  50:  IF DI[531]=ON, JMP LBL[8]    ;
  51:  WAIT .1(sec)    ;
  52:  R[90]=R[90]+1    ;
  53:  IF R[90]<50, JMP LBL[7]    ;
  54:  !  Unlock timeout: fault; resume re-commands + re-waits (LBL[41]) - ;
  55:  !  no motion while the tool may still be spring-locked in the dock ;
  56:  CALL SET_STR('TOOLCHG:UNLOCK TIMEOUT',1)    ;
  57:  CALL R1_TOWER(1,3)    ;
  58:  PAUSE    ;
  59:  CALL R1_TOWER(3,0)    ;
  60:  JMP LBL[41]    ;
  61:  LBL[8]    ;
  62:  !  Retract clear BEFORE de-energising so spring cannot re-grab ;
  63:  L PR[2] 100mm/sec FINE    ;
  64:  DO[532]=OFF    ;
  65:  R[21]=0    ;
  66:  LBL[6]    ;
  67:   ;
  68:  !--- STEP 2: PICK TARGET TOOL --- ;
  69:  !  Guard: R[20] must resolve to a dock (1/2/3) BEFORE the coupler ;
  70:  !  opens - an invalid target would spring-lock on nothing. ;
  71:  LBL[49]    ;
  72:  IF R[20]=1, JMP LBL[10]    ;
  73:  IF R[20]=2, JMP LBL[10]    ;
  74:  IF R[20]=3, JMP LBL[10]    ;
  75:  CALL SET_STR('TOOLCHG:BAD TARGET',1)    ;
  76:  CALL R1_TOWER(1,3)    ;
  77:  PAUSE    ;
  78:  CALL R1_TOWER(3,0)    ;
  79:  JMP LBL[49]    ;
  80:  LBL[10]    ;
  81:  J PR[2] 100% FINE    ;
  82:  !  Open coupler to receive a tool ;
  83:  DO[532]=ON    ;
  84:  IF R[20]=1, JMP LBL[11]    ;
  85:  IF R[20]=2, JMP LBL[12]    ;
  86:  IF R[20]=3, JMP LBL[13]    ;
  87:   ;
  88:  LBL[11]    ;
  89:  !  Target tool must be present in its dock; resume re-checks ;
  90:  LBL[42]    ;
  91:  IF DI[501]=ON, JMP LBL[14]    ;
  92:  CALL SET_STR('TOOLCHG:VS NOT IN RACK',1)    ;
  93:  CALL R1_TOWER(1,3)    ;
  94:  PAUSE    ;
  95:  CALL R1_TOWER(3,0)    ;
  96:  JMP LBL[42]    ;
  97:  LBL[14]    ;
  98:  L PR[3] 200mm/sec FINE    ;
  99:  JMP LBL[19]    ;
 100:   ;
 101:  LBL[12]    ;
 102:  LBL[43]    ;
 103:  IF DI[502]=ON, JMP LBL[15]    ;
 104:  CALL SET_STR('TOOLCHG:LR NOT IN RACK',1)    ;
 105:  CALL R1_TOWER(1,3)    ;
 106:  PAUSE    ;
 107:  CALL R1_TOWER(3,0)    ;
 108:  JMP LBL[43]    ;
 109:  LBL[15]    ;
 110:  L PR[4] 200mm/sec FINE    ;
 111:  JMP LBL[19]    ;
 112:   ;
 113:  LBL[13]    ;
 114:  LBL[44]    ;
 115:  IF DI[503]=ON, JMP LBL[16]    ;
 116:  CALL SET_STR('TOOLCHG:SR NOT IN RACK',1)    ;
 117:  CALL R1_TOWER(1,3)    ;
 118:  PAUSE    ;
 119:  CALL R1_TOWER(3,0)    ;
 120:  JMP LBL[44]    ;
 121:  LBL[16]    ;
 122:  L PR[5] 200mm/sec FINE    ;
 123:  LBL[19]    ;
 124:   ;
 125:  !--- STEP 3: LOCK TOOL (de-energise: spring locks) --- ;
 126:  !  Lock confirm = tool-ID bits match the commanded target (identity ;
 127:  !  AND engagement in one - catches swapped docks too). Transient ;
 128:  !  partial bit reads during seating are harmless: no motion here. ;
 129:  LBL[45]    ;
 130:  DO[532]=OFF    ;
 131:  R[90]=0    ;
 132:  LBL[20]    ;
 133:  CALL R1_CHECK_TOOL    ;
 134:  R[30]=R[21]-R[20]    ;
 135:  IF R[30]=0, JMP LBL[21]    ;
 136:  WAIT .1(sec)    ;
 137:  R[90]=R[90]+1    ;
 138:  IF R[90]<50, JMP LBL[20]    ;
 139:  !  Lock timeout: fault; resume re-locks + re-waits (LBL[45]) - ;
 140:  !  no motion while the coupler may not be engaged (tool can drop) ;
 141:  CALL SET_STR('TOOLCHG:LOCK TIMEOUT',1)    ;
 142:  CALL R1_TOWER(1,3)    ;
 143:  PAUSE    ;
 144:  CALL R1_TOWER(3,0)    ;
 145:  JMP LBL[45]    ;
 146:  LBL[21]    ;
 147:  !  Cross-check: bearings must NOT be retracted (DI[531]=OFF) - the ;
 148:  !  ID pins can mate before full mechanical lock (bench item). ;
 149:  LBL[46]    ;
 150:  IF DI[531]=OFF, JMP LBL[47]    ;
 151:  CALL SET_STR('TOOLCHG:NOT LOCKED',1)    ;
 152:  CALL R1_TOWER(1,3)    ;
 153:  PAUSE    ;
 154:  CALL R1_TOWER(3,0)    ;
 155:  JMP LBL[46]    ;
 156:  LBL[47]    ;
 157:  L PR[2] 100mm/sec FINE    ;
 158:   ;
 159:  !--- STEP 4: VERIFY CORRECT RACK SLOT IS NOW EMPTY --- ;
 160:  IF R[20]=1, JMP LBL[31]    ;
 161:  IF R[20]=2, JMP LBL[32]    ;
 162:  JMP LBL[33]    ;
 163:  LBL[31]    ;
 164:  LBL[48]    ;
 165:  IF DI[501]=OFF, JMP LBL[39]    ;
 166:  JMP LBL[38]    ;
 167:  LBL[32]    ;
 168:  LBL[52]    ;
 169:  IF DI[502]=OFF, JMP LBL[39]    ;
 170:  JMP LBL[38]    ;
 171:  LBL[33]    ;
 172:  LBL[53]    ;
 173:  IF DI[503]=OFF, JMP LBL[39]    ;
 174:  LBL[38]    ;
 175:  !  Rack sensor still ON after lock = wrong tool or sensor fault; ;
 176:  !  resume re-checks the sensor (dispatch by R[20], no fall-through) ;
 177:  CALL SET_STR('TOOLCHG:RACK NOT EMPTY',1)    ;
 178:  CALL R1_TOWER(1,3)    ;
 179:  PAUSE    ;
 180:  CALL R1_TOWER(3,0)    ;
 181:  IF R[20]=1, JMP LBL[48]    ;
 182:  IF R[20]=2, JMP LBL[52]    ;
 183:  JMP LBL[53]    ;
 184:  LBL[39]    ;
 185:   ;
 186:  !  Tool frame already selected by R1_CHECK_TOOL (STEP 4, hardware) ;
 187:  !  PAYLOAD[R[21]+1] recommended once schedules are defined ;
/END
