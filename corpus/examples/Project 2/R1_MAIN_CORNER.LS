/PROG R1_MAIN_CORNER
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "PNS3 Corner main cycle V3";
PROG_SIZE	= 0;
CREATE		= DATE 26-07-16  TIME 00:00:00;
MODIFIED	= DATE 26-07-16  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !--- V3 MAIN (CORNER): manual screwing cell ---    ;
   2:  ! Operator loaded Top Cover at P2 (operator station, LEFT). PC ran    ;
   3:  ! pre-checks and pulsed PNS 3. Nest: 0 deg, unlocked, at P2.    ;
   4:  ! Flow: nest->P1, verify, PnP VS FIRST then poly, flip, deliver, END.    ;
   5:  ! VS-first (2026-07-19): VS tool = tool 1 for ALL recipes, so the    ;
   6:  ! start tool-check and the end pre-swap are recipe-proof.    ;
   7:  ! Screwing = operator + semi-auto SD; release via PNS 4 R1_RELEASE.    ;
   8:  !--- CYCLE START: TOWER ORANGE (DV2130), CLEAR FAULT INDICATION ---    ;
   9:  CALL R1_TOWER(3,0)    ;
  10:  ! Recipe flag: 3=CORNER. Verify sub-programs read R[7].    ;
  11:  R[7]=3    ;
  12:  ! SR[2] = status string. Visible on HMI display, logged to FITS MES.    ;
  13:  CALL SET_STR('CYCLE START',2)    ;
  14:   ;
  15:  !--- STEP 1: IDENTIFY TOOL FROM HARDWARE ---    ;
  16:  ! DI[713]/DI[714] 2-bit tool indicator -> R[21] + UTOOL_NUM.    ;
  17:  CALL R1_CHECK_TOOL    ;
  18:   ;
  19:  !--- STEP 1b: NO STALE PART ON TOOL (audit 2026-07-27) ---    ;
  20:  ! Mid-carry abort can leave a component gripped/vacuum-held.    ;
  21:  ! Proceeding would drop it at an arbitrary pose or dock it into    ;
  22:  ! the rack. Operator removes the part, then CYCLE START re-checks.    ;
  23:  LBL[60]    ;
  24:  IF DI[533]=OFF, JMP LBL[61]    ;
  25:  CALL SET_STR('PART IN GRIPPER AT START',1)    ;
  26:  CALL R1_TOWER(1,3)    ;
  27:  PAUSE    ;
  28:  CALL R1_TOWER(3,0)    ;
  29:  JMP LBL[60]    ;
  30:  LBL[61]    ;
  31:   ;
  32:  !--- STEP 2: ENSURE VS TOOL ON ROBOT (tool 1 - ALL recipes) ---    ;
  33:  ! VS-first: pre-swap at cycle end mounts tool 1, which is correct    ;
  34:  ! for every recipe -> this skip fires every cycle but the first.    ;
  35:  IF R[21]=1, JMP LBL[1]    ;
  36:  R[20]=1    ;
  37:  CALL R1_TOOL_CHG    ;
  38:  LBL[1]    ;
  39:   ;
  40:  !--- STEP 3: BRING NEST TO PnP SIDE (V3) ---    ;
  41:  ! Nest travels P2->P1 UNCLAMPED: pistons open (they clamp the scanners,    ;
  42:  ! not yet placed) and linear retracted. Top Cover held by nest pocket    ;
  43:  ! only - CONFIRM captive for axis travel (mechanical review).    ;
  44:  !--- STEP 3a: NEST STATE GATE (audit 2026-07-27) ---    ;
  45:  ! The unclamped leg REQUIRES flipper@0 + linear retracted + all 4    ;
  46:  ! pistons released. A locked/flipped nest at P2 (mid-cycle abort,    ;
  47:  ! or PNS 1-3 pulsed instead of PNS 4 with a screwed unit aboard)    ;
  48:  ! must NOT be driven into the P1-side hardware. NO auto-normalize:    ;
  49:  ! a flipped nest may carry a finished unit - releasing would drop it.    ;
  50:  LBL[62]    ;
  51:  IF DI[435]=OFF, JMP LBL[63]    ;
  52:  IF DI[433]=OFF, JMP LBL[63]    ;
  53:  IF DI[402]=OFF, JMP LBL[63]    ;
  54:  IF DI[404]=OFF, JMP LBL[63]    ;
  55:  IF DI[406]=OFF, JMP LBL[63]    ;
  56:  IF DI[408]=OFF, JMP LBL[63]    ;
  57:  JMP LBL[64]    ;
  58:  LBL[63]    ;
  59:  CALL SET_STR('NEST NOT SAFE FOR TRAVEL',1)    ;
  60:  CALL R1_TOWER(1,3)    ;
  61:  PAUSE    ;
  62:  CALL R1_TOWER(3,0)    ;
  63:  JMP LBL[62]    ;
  64:  LBL[64]    ;
  65:  CALL SET_STR('NEST TO P1',2)    ;
  66:  J PR[50] 100% FINE    ;
  67:  CALL R1_AXIS_P1    ;
  68:   ;
  69:  !--- STEP 4: LIDAR BARCODE + MES (V3, R[50]=9) ---    ;
  70:  ! SR1000 #1 mounting TBD. If SN already validated at load, PC just    ;
  71:  ! returns R[51]=1. NOK -> Top Cover back to operator.    ;
  72:  CALL SET_STR('LIDAR BARCODE',2)    ;
  73:  R[50]=9    ;
  74:  CALL R1_PC_REQ    ;
  75:  IF R[51]=1, JMP LBL[23]    ;
  76:  CALL SET_STR('LIDAR MES NOK',1)    ;
  77:  CALL R1_RETURN_REJECT    ;
  78:  JMP LBL[99]    ;
  79:  LBL[23]    ;
  80:   ;
  81:  !--- STEP 5+6: TRAY SCANS - IV3 DIRECT (2026-08-02, no PC) ---    ;
  82:  ! R1_SCAN_VS / R1_SCAN_POLY replace PC codes 4/3: they own the    ;
  83:  ! scan-pose motion, IV3 program select, trigger, and first-    ;
  84:  ! occupied-slot read; tray toggle + both-empty operator PAUSE    ;
  85:  ! live inside. Return guaranteed R[4]/R[1] in 1-10.    ;
  86:  ! VS tray FIRST (matches VS-first assembly, 2026-07-19).    ;
  87:  CALL SET_STR('VS TRAY SCAN',2)    ;
  88:  CALL R1_SCAN_VS    ;
  89:  CALL SET_STR('POLY TRAY SCAN',2)    ;
  90:  CALL R1_SCAN_POLY    ;
  91:   ;
  92:  !--- STEP 7: HEIGHT CHECK 3 POSITIONS (#8 first) ---    ;
  93:  ! R[50]=21 captures each point; R[50]=2 = verdict on all 3.    ;
  94:  CALL SET_STR('HEIGHT CHECK',2)    ;
  95:  J PR[61] 80% FINE    ;
  96:  R[50]=21    ;
  97:  CALL R1_PC_REQ    ;
  98:  J PR[62] 50% FINE    ;
  99:  R[50]=21    ;
 100:  CALL R1_PC_REQ    ;
 101:  J PR[63] 50% FINE    ;
 102:  R[50]=21    ;
 103:  CALL R1_PC_REQ    ;
 104:  R[50]=2    ;
 105:  CALL R1_PC_REQ    ;
 106:  IF R[51]=1, JMP LBL[21]    ;
 107:  ! Height NOK -> Top Cover back to operator (V3 reject matrix)    ;
 108:  CALL SET_STR('HEIGHT NOK',1)    ;
 109:  CALL R1_RETURN_REJECT    ;
 110:  JMP LBL[99]    ;
 111:  LBL[21]    ;
 112:   ;
 113:  !--- STEP 8: O-RING CHECK (#8 second) ---    ;
 114:  CALL SET_STR('ORING CHECK',2)    ;
 115:  J PR[60] 80% FINE    ;
 116:  ! R[50]=1: O-ring camera check. 1=OK 2=NOK.    ;
 117:  R[50]=1    ;
 118:  CALL R1_PC_REQ    ;
 119:  IF R[51]=1, JMP LBL[22]    ;
 120:  CALL SET_STR('ORING NOK',1)    ;
 121:  CALL R1_RETURN_REJECT    ;
 122:  JMP LBL[99]    ;
 123:  LBL[22]    ;
 124:   ;
 125:  !--- STEP 9: PICK + BARCODE VS (V3: NOK->bin->next, max 3) ---    ;
 126:  ! VS FIRST (2026-07-19): VS tool already on from STEP 2 / pre-swap.    ;
 127:  ! R[52] counts binned components this phase. PR[33]=SR1000 #2.    ;
 128:  R[52]=0    ;
 129:  LBL[41]    ;
 130:  CALL SET_STR('PICK VS',2)    ;
 131:  CALL R1_PICK_VS    ;
 132:  CALL SET_STR('VS BARCODE',2)    ;
 133:  J PR[33] 60% FINE    ;
 134:  ! R[50]=5: SN + MES bind. 1=accepted 2=rejected.    ;
 135:  R[50]=5    ;
 136:  CALL R1_PC_REQ    ;
 137:  IF R[51]=1, JMP LBL[17]    ;
 138:  ! MES rejected -> bin it and pick the next component (V3)    ;
 139:  CALL SET_STR('VS MES REJECTED',1)    ;
 140:  CALL R1_REJECT    ;
 141:  R[52]=R[52]+1    ;
 142:  IF R[52]<3, JMP LBL[51]    ;
 143:  ! 3 rejects -> abort cycle, Top Cover back to operator    ;
 144:  CALL SET_STR('VS REJECT LIMIT',1)    ;
 145:  CALL R1_RETURN_REJECT    ;
 146:  JMP LBL[99]    ;
 147:  LBL[51]    ;
 148:  ! Re-scan VS trays (binned slot now empty -> next occupied slot;    ;
 149:  ! IV3 direct - scan program owns motion/toggle/empty PAUSE)    ;
 150:  CALL R1_SCAN_VS    ;
 151:  JMP LBL[41]    ;
 152:  LBL[17]    ;
 153:   ;
 154:  !--- STEP 10: PLACE VS - CORNER ---    ;
 155:  CALL SET_STR('PLACE VS',2)    ;
 156:  CALL R1_PLACE_VS_CORNER    ;
 157:   ;
 158:  !--- STEP 11: VERIFY VS (#15; V3: NOK -> back to operator) ---    ;
 159:  CALL SET_STR('VERIFY VS',2)    ;
 160:  CALL R1_PLACE_VERIFY_VS    ;
 161:  IF R[51]=1, JMP LBL[27]    ;
 162:  CALL R1_RETURN_REJECT    ;
 163:  JMP LBL[99]    ;
 164:  LBL[27]    ;
 165:   ;
 166:  !--- STEP 12: CHANGE TO LR/CORNER POLYGON TOOL (2) (tool 2) ---    ;
 167:  ! Recipe-specific polygon tool - the only recipe-dependent change.    ;
 168:  CALL SET_STR('TOOL CHG POLY',2)    ;
 169:  R[20]=2    ;
 170:  CALL R1_TOOL_CHG    ;
 171:   ;
 172:  !--- STEP 13: PICK + BARCODE POLYGON (V3: NOK->bin->next, max 3) ---    ;
 173:  R[52]=0    ;
 174:  LBL[40]    ;
 175:  CALL SET_STR('PICK POLY',2)    ;
 176:  CALL R1_PICK_POLY    ;
 177:  CALL SET_STR('POLY BARCODE',2)    ;
 178:  J PR[33] 60% FINE    ;
 179:  R[50]=5    ;
 180:  CALL R1_PC_REQ    ;
 181:  IF R[51]=1, JMP LBL[16]    ;
 182:  CALL SET_STR('POLY MES REJECTED',1)    ;
 183:  CALL R1_REJECT    ;
 184:  R[52]=R[52]+1    ;
 185:  IF R[52]<3, JMP LBL[42]    ;
 186:  CALL SET_STR('POLY REJECT LIMIT',1)    ;
 187:  CALL R1_RETURN_REJECT    ;
 188:  JMP LBL[99]    ;
 189:  LBL[42]    ;
 190:  ! Re-scan poly trays (IV3 direct)    ;
 191:  CALL R1_SCAN_POLY    ;
 192:  JMP LBL[40]    ;
 193:  LBL[16]    ;
 194:   ;
 195:  !--- STEP 14: PLACE POLYGON - CORNER ---    ;
 196:  CALL SET_STR('PLACE POLY',2)    ;
 197:  CALL R1_PLACE_POLY_CORNER    ;
 198:   ;
 199:  !--- STEP 15: VERIFY POLYGON (#15; V3: NOK -> back to operator) ---    ;
 200:  CALL SET_STR('VERIFY POLY',2)    ;
 201:  CALL R1_PLACE_VERIFY_POLY    ;
 202:  IF R[51]=1, JMP LBL[24]    ;
 203:  CALL R1_RETURN_REJECT    ;
 204:  JMP LBL[99]    ;
 205:  LBL[24]    ;
 206:   ;
 207:  !--- STEP 16: PRE-SWAP TO VS TOOL (BEFORE delivery, 2026-07-20) ---    ;
 208:  ! Robot motion is FORBIDDEN once the operator window opens, so the    ;
 209:  ! swap runs NOW, nest still at P1. VS = tool 1 for ALL recipes ->    ;
 210:  ! never wrong; next cycle STEP 2 always skips. (True overlap with    ;
 211:  ! flip/travel would need multitasking - rejected for complexity.)    ;
 212:  CALL SET_STR('PRE-SWAP VS TOOL',2)    ;
 213:  IF R[21]=1, JMP LBL[19]    ;
 214:  R[20]=1    ;
 215:  CALL R1_TOOL_CHG    ;
 216:  LBL[19]    ;
 217:   ;
 218:  !--- STEP 17: NEST LOCK ---    ;
 219:  ! PR[50] = piston-safe position: TCP clear of nest envelope.    ;
 220:  CALL SET_STR('NEST LOCK',2)    ;
 221:  J PR[50] 100% FINE    ;
 222:  CALL R1_NEST_LOCK    ;
 223:   ;
 224:  !--- STEP 18: FLIP 0 -> 180 (screw side up for operator) ---    ;
 225:  CALL SET_STR('NEST FLIP',2)    ;
 226:  CALL R1_NEST_FLIP    ;
 227:   ;
 228:  !--- STEP 19: READY TO SEND CHECK ---    ;
 229:  ! Verify linear+pistons+flip+axis state before travel to operator.    ;
 230:  CALL SET_STR('READY CHK SEND',2)    ;
 231:  CALL R1_READY_SEND    ;
 232:   ;
 233:  !--- STEP 20: ROBOT HOME - R1 does NOT move again this cycle ---    ;
 234:  J PR[1] 100% FINE    ;
 235:   ;
 236:  !--- STEP 21: DELIVER NEST TO OPERATOR (AXIS -> P2) ---    ;
 237:  ! R1_AXIS_P2 is retry-on-resume: timeout / LC-crossed-mid-travel    ;
 238:  ! de-commands the valve, RED+PAUSE; HMI Resume retries the move.    ;
 239:  CALL SET_STR('DELIVER TO OP',2)    ;
 240:  CALL R1_AXIS_P2    ;
 241:   ;
 242:  !--- STEP 22: DELIVERED ON P2 CONFIRM - TP MAIN ENDS ---    ;
 243:  ! DO[21] pulse: PC -> curtain MUTING + HMI 'Start SD'. Operator:    ;
 244:  ! SD sequence -> 'SD Approved' (or 'SD failed' -> unit = reject)    ;
 245:  ! -> FLIP button (active press) -> safety clear -> PNS 4 R1_RELEASE.    ;
 246:  DO[21]=ON    ;
 247:  WAIT .5(sec)    ;
 248:  DO[21]=OFF    ;
 249:  CALL SET_STR('WAIT SCREWING',2)    ;
 250:  LBL[99]    ;
/END
