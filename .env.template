# .env.template -- course delivery (Vercel + LLMod.ai + Supabase + Pinecone)
# Copy to .env and fill values locally. NEVER commit .env.
# Mirror the same names/values in Vercel > Project > Settings > Environment Variables.

# --- LLM provider: LLMod.ai only (one group key, $9 total budget) ---
LLMOD_BASE_URL=https://api.llmod.ai
LLMOD_API_KEY=
# exact model ids from the LLMod platform dropdowns (deployment-prefixed):
EMBED_MODEL=NBUECSE-text-embedding-3-small
TP_LLM1=
# development default is the mock; switch to llmod:<model> only for live smokes:
TP_LLM2=mock:tests/fixtures/v1.ls

# --- Vector DB (RAG) ---
PINECONE_API_KEY=
PINECONE_INDEX=fanuc-tp-online

# --- Primary DB (stores: sessions, drafts, verdicts, outputs, reg_io_tables) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- App ---
DEMO_CELL=line3_fanuc1
